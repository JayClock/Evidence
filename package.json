{
  "name": "@evidence/source",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "dev:web": "nx dev @evidence/web",
    "dev:server": "nx serve @evidence/server",
    "dev:desktop": "nx dev @evidence/desktop",
    "dev:desktop:remote": "nx run @evidence/desktop:dev-remote",
    "build": "nx run-many -t build --exclude=@evidence/source",
    "typecheck": "nx run-many -t typecheck --exclude=@evidence/source",
    "lint": "nx run-many -t lint --exclude=@evidence/source",
    "test": "nx run-many -t test",
    "api:export": "node tools/openapi.mjs",
    "api:check": "node tools/openapi.mjs --check",
    "api:generate": "node tools/openapi.mjs --write",
    "api:contracts": "nx run @evidence/api-contracts:contract-local",
    "api:contracts:java": "nx run @evidence/api-contracts:contract-local-java",
    "api:contracts:remote": "nx run @evidence/api-contracts:contract",
    "compatibility:check": "nx run @evidence/api-contracts:test --run src/lib/compatibility-baseline.spec.ts && nx run :server-java:domain:test",
    "ui:shadcn": "pnpm --filter @evidence/ui exec shadcn",
    "ui:ai-elements": "pnpm --filter @evidence/ui exec elements add",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.7.3",
    "@nx/eslint-plugin": "22.7.3",
    "@nx/gradle": "22.7.3",
    "@nx/js": "22.7.3",
    "@nx/react": "22.7.3",
    "@nx/vite": "22.7.3",
    "@nx/vitest": "22.7.3",
    "@nx/web": "22.7.3",
    "@nx/workspace": "22.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "lint-staged": "^17.0.5",
    "nx": "22.7.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "~3.6.2",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0",
    "typebox": "1.1.38",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  }
}
