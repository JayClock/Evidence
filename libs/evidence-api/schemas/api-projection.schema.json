{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence.local/api-snapshot/v7/api-projection.schema.json",
  "type": "object",
  "$defs": {
    "breachBranch": {
      "type": "object",
      "required": ["kind", "relationshipRef", "breachedRequestRef"],
      "properties": {
        "kind": { "enum": ["breach_compensation", "escalation"] },
        "relationshipRef": { "type": "string" },
        "breachedRequestRef": { "type": "string" },
        "condition": { "type": "string" },
        "remedyKind": { "type": "string" }
      },
      "if": { "properties": { "kind": { "const": "escalation" } } },
      "then": { "required": ["remedyKind"] },
      "else": { "not": { "required": ["remedyKind"] } },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "apiId",
    "mode",
    "modelId",
    "modelName",
    "modelVersion",
    "routes",
    "hypermedia",
    "services",
    "links",
    "openapi",
    "limitations",
    "journeys",
    "diagnostics",
    "digests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "7.0"
    },
    "apiId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "draft"
    },
    "modelId": {
      "type": "string"
    },
    "modelName": {
      "type": "string"
    },
    "modelVersion": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operationId",
          "method",
          "path",
          "entityRef",
          "fields",
          "derived",
          "stamped",
          "responses",
          "shape",
          "itemPath",
          "allowedPartyRoleRefs",
          "exposure",
          "outputFields",
          "rules",
          "responseShape",
          "parameterEntityRefs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operationId": {
            "type": "string"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "entityRef": {
            "type": "string"
          },
          "breachBranch": { "$ref": "#/$defs/breachBranch" },
          "fields": {
            "type": "array"
          },
          "derived": {
            "type": "array"
          },
          "stamped": {
            "type": "array"
          },
          "responses": {
            "type": "array"
          },
          "shape": {
            "enum": [
              "singleton",
              "collection"
            ]
          },
          "itemPath": {
            "type": "string",
            "pattern": "^/"
          },
          "allowedCallbackRoleRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowedPartyRoleRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "exposure": {
            "enum": [
              "external",
              "internal"
            ]
          },
          "outputFields": {
            "type": "array"
          },
          "rules": {
            "type": "array"
          },
          "responseShape": {
            "enum": [
              "item",
              "collection"
            ]
          },
          "parameterEntityRefs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "hypermedia": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceRouteId",
          "targetRouteId",
          "rel",
          "href",
          "method",
          "templated"
        ],
        "properties": {
          "sourceRouteId": {
            "type": "string"
          },
          "targetRouteId": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "templated": {
            "type": "boolean"
          },
          "breachBranch": { "$ref": "#/$defs/breachBranch" }
        },
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "contextRef",
          "routePrefixes",
          "routes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "contextRef": {
            "type": "string"
          },
          "routePrefixes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "routes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "not": {
          "required": [
            "lane"
          ]
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "openapi": {
      "type": "object",
      "required": [
        "openapi",
        "info",
        "paths",
        "components"
      ],
      "properties": {
        "openapi": {
          "const": "3.1.0"
        },
        "info": {
          "type": "object"
        },
        "paths": {
          "type": "object"
        },
        "components": {
          "type": "object"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roleRef",
          "routeId",
          "method",
          "path",
          "purpose",
          "nextPossibleSteps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "roleRef": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "nextPossibleSteps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "gap",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "design": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkReport": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
