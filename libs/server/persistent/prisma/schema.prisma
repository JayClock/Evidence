  observedOutcomes   Json             @map("observed_outcomes")
  residualRisks      Json             @map("residual_risks")
  nextProbe          Json             @map("next_probe")
  proposedAt         DateTime         @map("proposed_at")
  contentSha256      String           @map("content_sha256")
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  iteration          Iteration        @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  story              Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyRevision      StoryRevision    @relation(fields: [storyRevisionId], references: [id], onDelete: Restrict)
  showcaseRun        ShowcaseRun      @relation(fields: [showcaseRunId], references: [id], onDelete: Restrict)
  showcaseDecision   ShowcaseDecision @relation(fields: [showcaseDecisionId], references: [id], onDelete: Restrict)
  decision           RespondDecision?

  @@unique([iterationId, sequence])
  @@unique([iterationId, actionId])
  @@unique([workspaceId, reference])
  @@index([iterationId, proposedAt])
  @@map("respond_candidates")
}

model RespondDecision {
  id              String           @id
  candidateId     String           @unique @map("candidate_id")
  action          String
  reason          String
  candidateSha256 String           @map("candidate_sha256")
  authoritySha256 String           @map("authority_sha256")
  decidedByUserId String           @map("decided_by_user_id")
  decidedAt       DateTime         @map("decided_at")
  contentSha256   String           @map("content_sha256")
  candidate       RespondCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  decidedBy       User             @relation("RespondDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([decidedByUserId, decidedAt])
  @@map("respond_decisions")
}

model StoryRevisionCitation {
  id              String        @id
  storyRevisionId String        @map("story_revision_id")
  inboxRevisionId String        @map("inbox_revision_id")
  position        Int
  locator         String
  storyRevision   StoryRevision @relation(fields: [storyRevisionId], references: [id], onDelete: Cascade)
  inboxRevision   InboxRevision @relation(fields: [inboxRevisionId], references: [id], onDelete: Restrict)

  @@unique([storyRevisionId, position])
  @@unique([storyRevisionId, inboxRevisionId, locator], map: "story_revision_citation_revision_locator_key")
  @@index([inboxRevisionId])
  @@map("story_revision_citations")
}
