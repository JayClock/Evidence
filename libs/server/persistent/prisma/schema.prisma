generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                       @id
  name                        String
  email                       String?
  members                     WorkspaceMember[]
  createdStoryRevisions       StoryRevision[]              @relation("StoryRevisionAuthor")
  requestedExtractions        InboxExtraction[]            @relation("InboxExtractionRequester")
  decidedInboxCandidates      InboxCandidateDecision[]     @relation("InboxCandidateDecisionActor")
  admittedIterations          Iteration[]                  @relation("IterationAdmissionActor")
  decidedKickoffProposals     KickoffDecision[]            @relation("KickoffDecisionActor")
  answeredClarifications      StoryClarification[]         @relation("ClarificationAnswerActor")
  waivedClarifications        StoryClarification[]         @relation("ClarificationWaiverActor")
  understandingDecisions      UnderstandingDecision[]      @relation("UnderstandingDecisionActor")
  noModelImpactDecisions      NoModelImpactDecision[]      @relation("NoModelImpactDecisionActor")
  deskCheckDecisions          DeskCheckDecision[]          @relation("DeskCheckDecisionActor")
  approvedTaskingPlans        ApprovedTaskingPlan[]        @relation("ApprovedTaskingPlanActor")
  pairCodingDecisions         PairCodingDecision[]         @relation("PairCodingDecisionActor")
  showcaseProductObservations ShowcaseProductObservation[] @relation("ShowcaseProductObservationActor")
  showcaseRiskDecisions       ShowcaseRiskDecision[]       @relation("ShowcaseRiskDecisionActor")
  showcaseEvaluations         ShowcaseEvaluation[]         @relation("ShowcaseEvaluationActor")
  showcaseDecisions           ShowcaseDecision[]           @relation("ShowcaseDecisionActor")
  respondDecisions            RespondDecision[]            @relation("RespondDecisionActor")

  @@map("users")
}

model Workspace {
  id                      String                   @id
  title                   String
  description             String?
  status                  String
  metadata                Json                     @default("{}")
  modelRoot               String                   @map("model_root")
  createdAt               DateTime                 @map("created_at")
  updatedAt               DateTime                 @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  members                 WorkspaceMember[]
  diagrams                Diagram[]
  logicalEntities         LogicalEntity[]
  logicalRelationships    LogicalRelationship[]
  inboxItems              InboxItem[]
  inboxExtractions        InboxExtraction[]
  inboxStoryCandidates    InboxStoryCandidate[]
  inboxCandidateDecisions InboxCandidateDecision[]
  iterations              Iteration[]
  activityRuns            ActivityRun[]
  stories                 Story[]
  storyClarifications     StoryClarification[]
  scenarioSetProposals    ScenarioSetProposal[]
  understandingDecisions  UnderstandingDecision[]
  noModelImpactDecisions  NoModelImpactDecision[]
  taskingCandidates       TaskingCandidate[]
  deskCheckDecisions      DeskCheckDecision[]
  approvedTaskingPlans    ApprovedTaskingPlan[]
  pairRuns                PairRun[]
  showcaseRuns            ShowcaseRun[]
  respondCandidates       RespondCandidate[]
  sequence                WorkspaceSequence?

  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Diagram {
  id          String        @id
  workspaceId String        @map("workspace_id")
  title       String
  viewport    Json
  createdAt   DateTime      @map("created_at")
  updatedAt   DateTime      @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes       DiagramNode[]
  edges       DiagramEdge[]

  @@index([workspaceId, deletedAt])
  @@map("diagrams")
}

model DiagramNode {
  id              String   @id
  diagramId       String   @map("diagram_id")
  kind            String
  logicalEntityId String?  @map("logical_entity_id")
  parentId        String?  @map("parent_id")
  position        Json
  width           Float?
  height          Float?
  data            Json     @default("{}")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")
  diagram         Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@index([diagramId])
  @@map("diagram_nodes")
}

model DiagramEdge {
  id                    String   @id
  diagramId             String   @map("diagram_id")
  sourceId              String   @map("source_id")
  targetId              String   @map("target_id")
  logicalRelationshipId String?  @map("logical_relationship_id")
  sourceHandle          String?  @map("source_handle")
  targetHandle          String?  @map("target_handle")
  kind                  String?
  style                 Json     @default("{}")
  data                  Json     @default("{}")
  animated              Boolean  @default(false)
  hidden                Boolean  @default(false)
  markerStart           Json?    @map("marker_start")
  markerEnd             Json?    @map("marker_end")
  pathOptions           Json     @default("{}") @map("path_options")
  interactionWidth      Float?   @map("interaction_width")
  createdAt             DateTime @map("created_at")
  updatedAt             DateTime @map("updated_at")
  diagram               Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@index([diagramId])
  @@map("diagram_edges")
}

model LogicalEntity {
  id          String    @id
  workspaceId String    @map("workspace_id")
  type        String
  subType     String?   @map("sub_type")
  name        String
  label       String?
  description String?
  attributes  Json      @default("[]")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deletedAt])
  @@map("logical_entities")
}

model LogicalRelationship {
  id          String    @id
  workspaceId String    @map("workspace_id")
  sourceId    String    @map("source_id")
  targetId    String    @map("target_id")
  label       String?
  deletedAt   DateTime? @map("deleted_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deletedAt])
  @@map("logical_relationships")
}

model InboxItem {
  id                 String                  @id
  workspaceId        String                  @map("workspace_id")
  sourceKind         String                  @map("source_kind")
  externalKey        String                  @map("external_key")
  title              String
  status             String
  latestRevisionId   String?                 @unique @map("latest_revision_id")
  version            Int                     @default(1)
  createdAt          DateTime                @map("created_at")
  updatedAt          DateTime                @map("updated_at")
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revisions          InboxRevision[]         @relation("InboxItemRevisions")
  latestRevision     InboxRevision?          @relation("LatestInboxRevision", fields: [latestRevisionId], references: [id], onDelete: Restrict)
  extractionSources  InboxExtractionSource[]
  candidateCitations InboxStoryCitation[]

  @@unique([workspaceId, sourceKind, externalKey])
  @@index([workspaceId, status, updatedAt])
  @@map("inbox_items")
}

model InboxRevision {
  id                      String                  @id
  inboxItemId             String                  @map("inbox_item_id")
  revisionNumber          Int                     @map("revision_number")
  title                   String
  body                    String
  contentType             String                  @map("content_type")
  uri                     String?
  providerMetadata        Json                    @default("{}") @map("provider_metadata")
  sourceUpdatedAt         DateTime?               @map("source_updated_at")
  capturedAt              DateTime                @map("captured_at")
  contentSha256           String                  @map("content_sha256")
  item                    InboxItem               @relation("InboxItemRevisions", fields: [inboxItemId], references: [id], onDelete: Cascade)
  latestForItem           InboxItem?              @relation("LatestInboxRevision")
  storyRevisionCitations  StoryRevisionCitation[]
  extractionSources       InboxExtractionSource[]
  inboxCandidateCitations InboxStoryCitation[]

  @@unique([inboxItemId, revisionNumber])
  @@unique([inboxItemId, contentSha256])
  @@map("inbox_revisions")
}

model WorkspaceSequence {
  workspaceId          String    @id @map("workspace_id")
  nextExtractionNumber Int       @default(1) @map("next_extraction_number")
  nextCandidateNumber  Int       @default(1) @map("next_candidate_number")
  nextDecisionNumber   Int       @default(1) @map("next_decision_number")
  nextIterationNumber  Int       @default(1) @map("next_iteration_number")
  nextKickoffNumber    Int       @default(1) @map("next_kickoff_number")
  updatedAt            DateTime  @map("updated_at")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_sequences")
}

model InboxExtraction {
  id                String                  @id
  reference         String
  workspaceId       String                  @map("workspace_id")
  status            String
  version           Int                     @default(1)
  requestedByUserId String                  @map("requested_by_user_id")
  requestedAt       DateTime                @map("requested_at")
  completedAt       DateTime?               @map("completed_at")
  failureSummary    String?                 @map("failure_summary")
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy       User                    @relation("InboxExtractionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  sources           InboxExtractionSource[]
  candidates        InboxStoryCandidate[]
  activityRuns      ActivityRun[]

  @@unique([workspaceId, reference])
  @@index([workspaceId, status, requestedAt])
  @@map("inbox_extractions")
}

model InboxExtractionSource {
  id               String          @id
  extractionId     String          @map("extraction_id")
  inboxItemId      String          @map("inbox_item_id")
  inboxRevisionId  String          @map("inbox_revision_id")
  position         Int
  revisionNumber   Int             @map("revision_number")
  sourceKind       String          @map("source_kind")
  externalKey      String          @map("external_key")
  itemStatus       String          @map("item_status")
  title            String
  body             String
  contentType      String          @map("content_type")
  uri              String?
  providerMetadata Json            @default("{}") @map("provider_metadata")
  sourceUpdatedAt  DateTime?       @map("source_updated_at")
  capturedAt       DateTime        @map("captured_at")
  contentSha256    String          @map("content_sha256")
  extraction       InboxExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  inboxItem        InboxItem       @relation(fields: [inboxItemId], references: [id], onDelete: Restrict)
  inboxRevision    InboxRevision   @relation(fields: [inboxRevisionId], references: [id], onDelete: Restrict)

  @@unique([extractionId, position])
  @@unique([extractionId, inboxItemId])
  @@index([inboxRevisionId])
  @@map("inbox_extraction_sources")
}

model InboxStoryCandidate {
  id                String                  @id
  reference         String
  workspaceId       String                  @map("workspace_id")
  extractionId      String                  @map("extraction_id")
  title             String
  problem           String
  role              String
  goal              String
  value             String
  cognitiveMode     String                  @map("cognitive_mode")
  contentSha256     String                  @map("content_sha256")
  proposedAt        DateTime                @map("proposed_at")
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extraction        InboxExtraction         @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  citations         InboxStoryCitation[]
  decision          InboxCandidateDecision?
  selectedIteration Iteration?

  @@unique([workspaceId, reference])
  @@index([workspaceId, proposedAt])
  @@map("inbox_story_candidates")
}

model InboxStoryCitation {
  id              String              @id
  candidateId     String              @map("candidate_id")
  inboxItemId     String              @map("inbox_item_id")
  inboxRevisionId String              @map("inbox_revision_id")
  position        Int
  locator         String
  revisionSha256  String              @map("revision_sha256")
  candidate       InboxStoryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  inboxItem       InboxItem           @relation(fields: [inboxItemId], references: [id], onDelete: Restrict)
  inboxRevision   InboxRevision       @relation(fields: [inboxRevisionId], references: [id], onDelete: Restrict)

  @@unique([candidateId, position])
  @@unique([candidateId, inboxRevisionId, locator], map: "inbox_story_citation_revision_locator_key")
  @@index([inboxRevisionId])
  @@map("inbox_story_citations")
}

model InboxCandidateDecision {
  id              String              @id
  reference       String
  workspaceId     String              @map("workspace_id")
  candidateId     String              @unique @map("candidate_id")
  candidateSha256 String              @map("candidate_sha256")
  action          String
  reason          String
  decidedByUserId String              @map("decided_by_user_id")
  decidedAt       DateTime            @map("decided_at")
  contentSha256   String              @map("content_sha256")
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate       InboxStoryCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  decidedBy       User                @relation("InboxCandidateDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, reference])
  @@index([workspaceId, decidedAt])
  @@map("inbox_candidate_decisions")
}

model Iteration {
  id                         String                  @id
  reference                  String
  workspaceId                String                  @map("workspace_id")
  sourceCandidateId          String                  @unique @map("source_candidate_id")
  sourceCandidateSha256      String                  @map("source_candidate_sha256")
  lifecycle                  String
  loop                       String
  stage                      String
  lane                       String
  version                    Int                     @default(1)
  baseCommitSha              String                  @map("base_commit_sha")
  branchName                 String?                 @map("branch_name")
  provisioningFailureSummary String?                 @map("provisioning_failure_summary")
  admittedByUserId           String                  @map("admitted_by_user_id")
  admittedAt                 DateTime                @map("admitted_at")
  updatedAt                  DateTime                @map("updated_at")
  workspace                  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceCandidate            InboxStoryCandidate     @relation(fields: [sourceCandidateId], references: [id], onDelete: Restrict)
  admittedBy                 User                    @relation("IterationAdmissionActor", fields: [admittedByUserId], references: [id], onDelete: Restrict)
  intake                     IterationIntake?
  kickoffProposals           KickoffProposal[]
  kickoffDecisions           KickoffDecision[]
  story                      Story?                  @relation("IterationStory")
  activityRuns               ActivityRun[]
  storyClarifications        StoryClarification[]
  scenarioSetProposals       ScenarioSetProposal[]
  understandingDecisions     UnderstandingDecision[]
  noModelImpactDecisions     NoModelImpactDecision[]
  taskingCandidates          TaskingCandidate[]
  deskCheckDecisions         DeskCheckDecision[]
  approvedTaskingPlans       ApprovedTaskingPlan[]
  pairRuns                   PairRun[]
  showcaseRuns               ShowcaseRun[]
  respondCandidates          RespondCandidate[]

  @@unique([workspaceId, reference])
  @@index([workspaceId, lifecycle, lane, admittedAt])
  @@map("iterations")
}

model IterationIntake {
  iterationId            String    @id @map("iteration_id")
  candidateSnapshot      Json      @map("candidate_snapshot")
  sourceSnapshots        Json      @map("source_snapshots")
  requirementsProjection String    @map("requirements_projection")
  contentSha256          String    @map("content_sha256")
  frozenAt               DateTime  @map("frozen_at")
  iteration              Iteration @relation(fields: [iterationId], references: [id], onDelete: Cascade)

  @@map("iteration_intakes")
}

model KickoffProposal {
  id            String           @id
  reference     String
  iterationId   String           @map("iteration_id")
  sequence      Int
  origin        String
  title         String
  problem       String
  role          String
  goal          String
  value         String
  cognitiveMode String           @map("cognitive_mode")
  citations     Json
  contentSha256 String           @map("content_sha256")
  proposedAt    DateTime         @map("proposed_at")
  iteration     Iteration        @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  decision      KickoffDecision?

  @@unique([iterationId, sequence])
  @@unique([iterationId, reference])
  @@index([iterationId, proposedAt])
  @@map("kickoff_proposals")
}

model KickoffDecision {
  id              String          @id
  reference       String
  iterationId     String          @map("iteration_id")
  proposalId      String          @unique @map("proposal_id")
  proposalSha256  String          @map("proposal_sha256")
  action          String
  reason          String?
  decidedByUserId String          @map("decided_by_user_id")
  decidedAt       DateTime        @map("decided_at")
  contentSha256   String          @map("content_sha256")
  iteration       Iteration       @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  proposal        KickoffProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  decidedBy       User            @relation("KickoffDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([iterationId, reference])
  @@index([iterationId, decidedAt])
  @@map("kickoff_decisions")
}

model ActivityRun {
  id               String           @id
  workspaceId      String           @map("workspace_id")
  extractionId     String?          @map("extraction_id")
  iterationId      String?          @map("iteration_id")
  kind             String
  status           String
  capabilitySha256 String           @map("capability_sha256")
  expiresAt        DateTime         @map("expires_at")
  startedAt        DateTime         @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  outputSha256     String?          @map("output_sha256")
  failureSummary   String?          @map("failure_summary")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extraction       InboxExtraction? @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  iteration        Iteration?       @relation(fields: [iterationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, expiresAt])
  @@index([extractionId])
  @@index([iterationId])
  @@map("activity_runs")
}

model ProblemStatementRevision {
  id             String   @id
  storyId        String   @map("story_id")
  iterationId    String   @map("iteration_id")
  revisionNumber Int      @map("revision_number")
  title          String
  problem        String
  cognitiveMode  String   @map("cognitive_mode")
  citations      Json
  contentSha256  String   @map("content_sha256")
  createdAt      DateTime @map("created_at")
  story          Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, revisionNumber])
  @@index([iterationId])
  @@map("problem_statement_revisions")
}

model StoryCardRevision {
  id                 String   @id
  storyId            String   @map("story_id")
  iterationId        String   @map("iteration_id")
  problemStatementId String   @map("problem_statement_id")
  revisionNumber     Int      @map("revision_number")
  title              String
  role               String
  goal               String
  value              String
  contentSha256      String   @map("content_sha256")
  createdAt          DateTime @map("created_at")
  story              Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, revisionNumber])
  @@index([iterationId])
  @@index([problemStatementId])
  @@map("story_card_revisions")
}

model Story {
  id                     String                     @id
  workspaceId            String                     @map("workspace_id")
  iterationId            String?                    @unique @map("iteration_id")
  reference              String
  latestRevisionId       String?                    @unique @map("latest_revision_id")
  version                Int                        @default(1)
  createdAt              DateTime                   @map("created_at")
  updatedAt              DateTime                   @map("updated_at")
  workspace              Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  iteration              Iteration?                 @relation("IterationStory", fields: [iterationId], references: [id], onDelete: Restrict)
  revisions              StoryRevision[]            @relation("StoryRevisions")
  latestRevision         StoryRevision?             @relation("LatestStoryRevision", fields: [latestRevisionId], references: [id], onDelete: Restrict)
  problemStatements      ProblemStatementRevision[]
  storyCards             StoryCardRevision[]
  clarifications         StoryClarification[]
  scenarioProposals      ScenarioSetProposal[]
  understandingDecisions UnderstandingDecision[]
  noModelImpactDecisions NoModelImpactDecision[]
  taskingCandidates      TaskingCandidate[]
  approvedTaskingPlans   ApprovedTaskingPlan[]
  pairRuns               PairRun[]
  showcaseRuns           ShowcaseRun[]
  respondCandidates      RespondCandidate[]

  @@index([workspaceId, updatedAt])
  @@map("stories")
}

model StoryRevision {
  id                             String                  @id
  storyId                        String                  @map("story_id")
  revisionNumber                 Int                     @map("revision_number")
  title                          String
  problem                        String
  role                           String
  goal                           String
  value                          String
  cognitiveMode                  String                  @map("cognitive_mode")
  contentSha256                  String                  @map("content_sha256")
  createdByUserId                String                  @map("created_by_user_id")
  createdAt                      DateTime                @map("created_at")
  story                          Story                   @relation("StoryRevisions", fields: [storyId], references: [id], onDelete: Cascade)
  latestForStory                 Story?                  @relation("LatestStoryRevision")
  createdBy                      User                    @relation("StoryRevisionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  citations                      StoryRevisionCitation[]
  scenarios                      StoryScenario[]
  clarificationQuestions         StoryClarification[]
  scenarioProposals              ScenarioSetProposal[]
  sourceUnderstandingDecisions   UnderstandingDecision[] @relation("UnderstandingDecisionSourceRevision")
  authorityUnderstandingDecision UnderstandingDecision?  @relation("UnderstandingDecisionStoryRevision", fields: [understandingDecisionId], references: [id], onDelete: Restrict)
  understandingDecisionId        String?                 @unique @map("understanding_decision_id")
  noModelImpactDecision          NoModelImpactDecision?
  taskingCandidates              TaskingCandidate[]
  approvedTaskingPlans           ApprovedTaskingPlan[]
  pairRuns                       PairRun[]
  showcaseRuns                   ShowcaseRun[]
  respondCandidates              RespondCandidate[]

  @@unique([storyId, revisionNumber])
  @@index([storyId, createdAt])
  @@map("story_revisions")
}

model StoryScenario {
  id                      String                       @id
  reference               String
  storyRevisionId         String                       @map("story_revision_id")
  sourceDraftId           String                       @map("source_draft_id")
  understandingDecisionId String                       @map("understanding_decision_id")
  position                Int
  title                   String
  givenSteps              Json                         @map("given_steps")
  whenStep                String                       @map("when_step")
  thenSteps               Json                         @map("then_steps")
  businessData            Json                         @map("business_data")
  confirmedAt             DateTime                     @map("confirmed_at")
  storyRevision           StoryRevision                @relation(fields: [storyRevisionId], references: [id], onDelete: Cascade)
  sourceDraft             ScenarioDraft                @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict)
  understandingDecision   UnderstandingDecision        @relation(fields: [understandingDecisionId], references: [id], onDelete: Restrict)
  showcaseObservations    ShowcaseProductObservation[]

  @@unique([storyRevisionId, position])
  @@unique([storyRevisionId, reference])
  @@index([sourceDraftId])
  @@index([understandingDecisionId])
  @@map("story_scenarios")
}

model StoryClarification {
  id               String        @id
  reference        String
  workspaceId      String        @map("workspace_id")
  iterationId      String        @map("iteration_id")
  storyId          String        @map("story_id")
  storyRevisionId  String        @map("story_revision_id")
  sequence         Int
  target           String
  question         String
  status           String
  askedAt          DateTime      @map("asked_at")
  answer           String?
  answeredByUserId String?       @map("answered_by_user_id")
  answeredAt       DateTime?     @map("answered_at")
  waivedReason     String?       @map("waived_reason")
  waivedByUserId   String?       @map("waived_by_user_id")
  waivedAt         DateTime?     @map("waived_at")
  contentSha256    String        @map("content_sha256")
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  iteration        Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  story            Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyRevision    StoryRevision @relation(fields: [storyRevisionId], references: [id], onDelete: Restrict)
  answeredBy       User?         @relation("ClarificationAnswerActor", fields: [answeredByUserId], references: [id], onDelete: Restrict)
  waivedBy         User?         @relation("ClarificationWaiverActor", fields: [waivedByUserId], references: [id], onDelete: Restrict)

  @@unique([iterationId, reference])
  @@unique([iterationId, sequence])
  @@index([workspaceId, iterationId, askedAt])
  @@index([storyRevisionId])
  @@map("story_clarifications")
}

model ScenarioSetProposal {
  id              String                 @id
  reference       String
