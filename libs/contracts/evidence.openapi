    StoryCognitiveMode:
      type: string
      enum: [clear, complicated, complex]
    StoryCitationInput:
      type: object
      required:
        - inboxItemId
        - inboxRevisionId
        - contentSha256
        - locator
      properties:
        inboxItemId:
          type: string
          minLength: 1
        inboxRevisionId:
          type: string
          minLength: 1
        contentSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        locator:
          type: string
          minLength: 1
          maxLength: 500
    StoryCitationResource:
      type: object
      required:
        - _links
        - inboxItemId
        - inboxRevisionId
        - inboxRevisionNumber
        - contentSha256
        - locator
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        inboxItemId:
          type: string
        inboxRevisionId:
          type: string
        inboxRevisionNumber:
          type: integer
          format: int32
          minimum: 1
        contentSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        locator:
          type: string
    StoryScenarioInput:
      type: object
      required:
        - title
        - given
        - when
        - then
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 200
        given:
          type: array
          minItems: 1
          maxItems: 20
          items:
            type: string
            minLength: 1
            maxLength: 2000
        when:
          type: string
          minLength: 1
          maxLength: 2000
        then:
          type: array
          minItems: 1
          maxItems: 20
          items:
            type: string
            minLength: 1
            maxLength: 2000
    StoryScenarioResource:
      type: object
      required:
        - id
        - reference
        - sourceDraftId
        - title
        - given
        - when
        - then
        - businessData
      properties:
        id:
          type: string
        reference:
          type: string
        sourceDraftId:
          type: string
        title:
          type: string
        given:
          type: array
          items:
            type: string
        when:
          type: string
        then:
          type: array
          items:
            type: string
        businessData:
          type: array
          items:
            type: string
    ClarificationTarget:
      type: string
      enum: [business_context, story, history]
    ClarificationStatus:
      type: string
      enum: [pending, answered, waived]
    AskClarificationInput:
      type: object
      required:
        [expectedIterationVersion, storyId, storyRevisionId, target, question]
      properties:
        expectedIterationVersion: { type: integer, format: int32, minimum: 1 }
        storyId: { type: string, minLength: 1 }
        storyRevisionId: { type: string, minLength: 1 }
        target: { $ref: '#/components/schemas/ClarificationTarget' }
        question: { type: string, minLength: 1, maxLength: 1536 }
    AnswerClarificationInput:
      type: object
      required: [expectedIterationVersion, answer]
      properties:
        expectedIterationVersion: { type: integer, format: int32, minimum: 1 }
        answer: { type: string, minLength: 1, maxLength: 16000 }
    ClarificationResource:
      type: object
      required:
        [
          id,
          reference,
          storyId,
          storyRevisionId,
          target,
          question,
          status,
          askedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        reference: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        target: { $ref: '#/components/schemas/ClarificationTarget' }
        question: { type: string }
        status: { $ref: '#/components/schemas/ClarificationStatus' }
        askedAt: { type: string, format: date-time }
        answer: { type: [string, 'null'] }
        answeredByUserId: { type: [string, 'null'] }
        answeredAt: { type: [string, 'null'], format: date-time }
        waivedReason: { type: [string, 'null'] }
        waivedByUserId: { type: [string, 'null'] }
        waivedAt: { type: [string, 'null'], format: date-time }
        contentSha256: { type: string }
    UnderstandingScenarioInput:
      type: object
      required: [title, given, when, then, businessData]
      properties:
        title: { type: string, minLength: 1, maxLength: 200 }
        given:
          type: array
          minItems: 1
          items: { type: string }
        when: { type: string, minLength: 1 }
        then:
          type: array
          minItems: 1
          items: { type: string }
        businessData:
          type: array
          minItems: 1
          items: { type: string }
    ScenarioProposalInput:
      type: object
      required: [expectedIterationVersion, storyId, storyRevisionId, scenarios]
      properties:
        expectedIterationVersion: { type: integer, format: int32, minimum: 1 }
        storyId: { type: string }
        storyRevisionId: { type: string }
        scenarios:
          type: array
          minItems: 1
          maxItems: 5
          items: { $ref: '#/components/schemas/UnderstandingScenarioInput' }
    ScenarioDraftResource:
      allOf:
        - $ref: '#/components/schemas/UnderstandingScenarioInput'
        - type: object
          required: [id, reference, position, contentSha256]
          properties:
            id: { type: string }
            reference: { type: string }
            position: { type: integer, format: int32, minimum: 0 }
            contentSha256: { type: string }
    ScenarioProposalResource:
      type: object
      required:
        [
          id,
          reference,
          storyId,
          storyRevisionId,
          sequence,
          drafts,
          proposedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        reference: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        sequence: { type: integer, format: int32, minimum: 1 }
        drafts:
          type: array
          items: { $ref: '#/components/schemas/ScenarioDraftResource' }
        proposedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    UnderstandingDecisionInput:
      type: object
      required: [expectedIterationVersion, action]
      properties:
        expectedIterationVersion: { type: integer, format: int32, minimum: 1 }
        action:
          type: string
          enum: [confirm, continue, split, defer]
        proposalId: { type: [string, 'null'] }
        proposalSha256: { type: [string, 'null'] }
        selectedDraftIds:
          type: array
          items: { type: string }
        reason: { type: [string, 'null'] }
    UnderstandingDecisionResource:
      type: object
      required:
        [
          id,
          reference,
          action,
          selectedDraftIds,
          confirmedScenarioIds,
          decidedByUserId,
          decidedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        reference: { type: string }
        proposalId: { type: [string, 'null'] }
        action: { type: string, enum: [confirm, continue, split, defer] }
        reason: { type: [string, 'null'] }
        selectedDraftIds:
          type: array
          items: { type: string }
        confirmedScenarioIds:
          type: array
          items: { type: string }
        decidedByUserId: { type: string }
        decidedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    UnderstandingResource:
      type: object
      required:
        [_links, iteration, story, storyRevision, clarifications, decisions]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        story: { $ref: '#/components/schemas/StoryResource' }
        storyRevision: { $ref: '#/components/schemas/StoryRevisionResource' }
        pendingClarification:
          oneOf:
            - $ref: '#/components/schemas/ClarificationResource'
            - type: 'null'
        clarifications:
          type: array
          items: { $ref: '#/components/schemas/ClarificationResource' }
        currentScenarioProposal:
          oneOf:
            - $ref: '#/components/schemas/ScenarioProposalResource'
            - type: 'null'
        decisions:
          type: array
          items: { $ref: '#/components/schemas/UnderstandingDecisionResource' }
    ClarificationAnswerResultResource:
      type: object
      required: [_links, iteration, clarification]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        clarification: { $ref: '#/components/schemas/ClarificationResource' }
    UnderstandingDecisionResultResource:
      type: object
      required: [_links, iteration, decision]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        decision: { $ref: '#/components/schemas/UnderstandingDecisionResource' }
        storyRevision:
          oneOf:
            - $ref: '#/components/schemas/StoryRevisionResource'
            - type: 'null'
    RecordNoModelImpactInput:
      type: object
      additionalProperties: false
      required:
        [
          expectedIterationVersion,
          storyId,
          storyRevisionId,
          storyRevisionSha256,
          reason,
        ]
      properties:
        expectedIterationVersion: { type: integer, format: int32, minimum: 1 }
        storyId: { type: string, minLength: 1 }
        storyRevisionId: { type: string, minLength: 1 }
        storyRevisionSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        reason: { type: string, minLength: 1, maxLength: 2000 }
    NoModelImpactDecisionResource:
      type: object
      required:
        [
          _links,
          id,
          reference,
          storyId,
          storyRevisionId,
          storyRevisionSha256,
          subject,
          method,
          modelChangeRequired,
          reason,
          decidedByUserId,
          decidedAt,
          contentSha256,
        ]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        id: { type: string }
        reference: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        storyRevisionSha256: { type: string }
        subject: { type: string, enum: [tool] }
        method: { type: string, enum: [none] }
        modelChangeRequired: { type: boolean, enum: [false] }
        reason: { type: string }
        decidedByUserId: { type: string }
        decidedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    TaskingFunctionalContext:
      type: string
      enum:
        [
          workspace,
          work-intake,
          delivery,
          logical-model,
          diagram-projection,
          model-proposal,
        ]
    TaskingTechnicalBoundary:
      type: string
      enum:
        [
          react-route,
          react-feature,
          rest-client,
          http-server,
          jaxrs-api,
          java-domain,
          mybatis-store,
          electron-main,
          electron-preload,
          desktop-binding-store,
          git-worktree,
          webview,
        ]
    TaskingProject:
      type: object
      additionalProperties: false
      required: [id, root, targets]
      properties:
        id: { type: string, minLength: 1, maxLength: 200 }
        root: { type: string, minLength: 1, maxLength: 500 }
        targets:
          type: array
          minItems: 1
          items: { type: string, minLength: 1 }
    TaskingProjectCatalog:
      type: object
      additionalProperties: false
      required: [projects]
      properties:
        projects:
          type: array
          minItems: 1
          items: { $ref: '#/components/schemas/TaskingProject' }
    TaskingRuntimeInput:
      type: object
      additionalProperties: false
      required:
        [id, runtime, functionalContexts, technicalBoundaries, projectIds]
      properties:
        id: { type: string, pattern: '^RUNTIME-[0-9]{3,}$' }
        runtime: { type: string, enum: [java, typescript] }
        functionalContexts:
          type: array
          minItems: 1
          items: { $ref: '#/components/schemas/TaskingFunctionalContext' }
        technicalBoundaries:
          type: array
          minItems: 1
          items: { $ref: '#/components/schemas/TaskingTechnicalBoundary' }
        projectIds:
          type: array
          minItems: 1
          items: { type: string }
    EmptyTaskingModelRefs:
      type: object
      additionalProperties: false
      required: [entities, associations]
      properties:
        entities:
          type: array
          maxItems: 0
          items: { type: string }
        associations:
          type: array
          maxItems: 0
          items: { type: string }
    TaskingTestInput:
      type: object
      additionalProperties: false
      required:
        [
          id,
          quadrant,
          intent,
          runtimePlanId,
          stepId,
          testFilter,
          supportedBy,
          scenarioIds,
          businessData,
          modelRefs,
        ]
      properties:
        id: { type: string, pattern: '^TEST-[0-9]{3,}$' }
        quadrant: { type: string, enum: [Q1, Q2] }
        intent: { type: string, minLength: 1, maxLength: 2000 }
        runtimePlanId: { type: string }
        stepId: { type: string }
        projectId: { type: [string, 'null'] }
        testFilter: { type: string, minLength: 1 }
        supportedBy:
          type: array
          items: { type: string }
        scenarioIds:
          type: array
          minItems: 1
          items: { type: string }
        scenarioOutcome: { type: [string, 'null'] }
        businessData:
          type: array
          items: { type: string }
        modelRefs: { $ref: '#/components/schemas/EmptyTaskingModelRefs' }
    TaskingTaskInput:
      type: object
      additionalProperties: false
      required: [id, description, testIds, dependsOn]
      properties:
        id: { type: string, pattern: '^TASK-[0-9]{3,}$' }
        description: { type: string, minLength: 1, maxLength: 2000 }
        testIds:
          type: array
          minItems: 1
          items: { type: string }
        dependsOn:
          type: array
          items: { type: string }
    ProposeTaskingInput:
      type: object
      additionalProperties: false
      required:
        [
          expectedIterationVersion,
          storyId,
          storyRevisionId,
          noModelImpactDecisionId,
          noModelImpactDecisionSha256,
          projectCatalog,
          runtimes,
          tests,
          tasks,
        ]
      properties:
        expectedIterationVersion: { type: integer, format: int32, minimum: 1 }
        storyId: { type: string, minLength: 1 }
        storyRevisionId: { type: string, minLength: 1 }
        noModelImpactDecisionId: { type: string, minLength: 1 }
        noModelImpactDecisionSha256:
          { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        projectCatalog: { $ref: '#/components/schemas/TaskingProjectCatalog' }
        runtimes:
          type: array
          minItems: 1
          items: { $ref: '#/components/schemas/TaskingRuntimeInput' }
        tests:
          type: array
          minItems: 2
          items: { $ref: '#/components/schemas/TaskingTestInput' }
        tasks:
          type: array
          minItems: 1
          items: { $ref: '#/components/schemas/TaskingTaskInput' }
    TaskingTestResource:
      allOf:
        - $ref: '#/components/schemas/TaskingTestInput'
        - type: object
          required: [processId, projectId, scenarioOutcome]
          properties:
            processId: { type: string }
            projectId: { type: [string, 'null'] }
            scenarioOutcome: { type: [string, 'null'] }
    TaskingTaskResource:
      allOf:
        - $ref: '#/components/schemas/TaskingTaskInput'
        - type: object
          required: [modelRefs]
          properties:
            modelRefs: { $ref: '#/components/schemas/EmptyTaskingModelRefs' }
    MaterializedTaskingCommand:
      type: object
      required: [testId, stepId, projectId, command]
      properties:
        testId: { type: string }
        stepId: { type: string }
        projectId: { type: [string, 'null'] }
        command: { type: string }
    MaterializedTaskingGate:
      type: object
      required: [projectId, target, command]
      properties:
        projectId: { type: [string, 'null'] }
        target: { type: [string, 'null'] }
        command: { type: string }
    TaskingProcessSelection:
      type: object
      required:
        [
          runtimePlanId,
          processId,
          processVersion,
          definitionSha256,
          functionalContexts,
          technicalBoundaries,
          selectedStepIds,
          projectIds,
          projectCatalogSha256,
          focusedCommands,
          qualityGates,
          materializedSha256,
        ]
      properties:
        runtimePlanId: { type: string }
        processId: { type: string }
        processVersion: { type: integer, enum: [3] }
        definitionSha256: { type: string }
        functionalContexts:
          type: array
          items: { $ref: '#/components/schemas/TaskingFunctionalContext' }
        technicalBoundaries:
          type: array
          items: { $ref: '#/components/schemas/TaskingTechnicalBoundary' }
        selectedStepIds:
          type: array
          items: { type: string }
        projectIds:
          type: array
          items: { type: string }
        projectCatalogSha256: { type: string }
        focusedCommands:
          type: array
          items: { $ref: '#/components/schemas/MaterializedTaskingCommand' }
        qualityGates:
          type: array
          items: { $ref: '#/components/schemas/MaterializedTaskingGate' }
        materializedSha256: { type: string }
    PairExecutionBudget:
      type: object
      required:
        [
          policyId,
          policyVersion,
          policySha256,
          activityTimeoutMs,
          commandTimeoutMs,
          maxAgentCalls,
          maxCheckpoints,
          maxRetriesPerFingerprint,
          maxNoProgressCheckpoints,
        ]
      properties:
        policyId: { type: string, enum: [pair-default] }
        policyVersion: { type: integer, enum: [2] }
        policySha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        activityTimeoutMs: { type: integer, minimum: 1 }
        commandTimeoutMs: { type: integer, minimum: 1 }
        maxAgentCalls: { type: integer, minimum: 1 }
        maxCheckpoints: { type: integer, minimum: 1 }
        maxRetriesPerFingerprint: { type: integer, minimum: 1 }
        maxNoProgressCheckpoints: { type: integer, minimum: 1 }
    TaskingCandidateSnapshot:
      type: object
      required:
        [
          planVersion,
          reference,
          storyId,
          storyRevisionId,
          storyRevisionSha256,
          baseCommitSha,
          noModelImpactDecisionId,
          noModelImpactDecisionSha256,
          sequence,
          projectCatalog,
          projectCatalogSha256,
          tests,
          tasks,
          processes,
          executionBudget,
          contentSha256,
          proposedBy,
          proposedAt,
        ]
      properties:
        planVersion: { type: integer, enum: [2] }
        reference: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        storyRevisionSha256: { type: string }
        baseCommitSha: { type: string }
        noModelImpactDecisionId: { type: string }
        noModelImpactDecisionSha256: { type: string }
        sequence: { type: integer, format: int32, minimum: 1 }
        projectCatalog: { $ref: '#/components/schemas/TaskingProjectCatalog' }
        projectCatalogSha256: { type: string }
        tests:
          type: array
          items: { $ref: '#/components/schemas/TaskingTestResource' }
        tasks:
          type: array
          items: { $ref: '#/components/schemas/TaskingTaskResource' }
        processes:
          type: array
          items: { $ref: '#/components/schemas/TaskingProcessSelection' }
        executionBudget: { $ref: '#/components/schemas/PairExecutionBudget' }
        contentSha256: { type: string }
        proposedBy: { type: string, enum: [tasking-analyst] }
        proposedAt: { type: string, format: date-time }
    TaskingCandidateResource:
      allOf:
        - $ref: '#/components/schemas/TaskingCandidateSnapshot'
        - type: object
          required: [_links, id]
          properties:
            _links: { $ref: '#/components/schemas/BTreeMap' }
            id: { type: string }
    DeskCheckAction:
      type: string
      enum: [approve, revise, architecture_gap, process_gap, scenario_gap]
    DeskCheckDecisionInput:
      type: object
      additionalProperties: false
      required: [expectedIterationVersion, candidateId, candidateSha256, action]
      properties:
        expectedIterationVersion: { type: integer, format: int32, minimum: 1 }
        candidateId: { type: string, minLength: 1 }
        candidateSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        action: { $ref: '#/components/schemas/DeskCheckAction' }
        reason: { type: [string, 'null'], maxLength: 2000 }
    DeskCheckDecisionResource:
      type: object
      required:
        [
          _links,
          id,
          reference,
          candidateId,
          candidateSha256,
          action,
          reason,
          decidedByUserId,
          decidedAt,
          contentSha256,
        ]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        id: { type: string }
        reference: { type: string }
        candidateId: { type: string }
        candidateSha256: { type: string }
        action: { $ref: '#/components/schemas/DeskCheckAction' }
        reason: { type: [string, 'null'] }
        decidedByUserId: { type: string }
        decidedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    ApprovedTaskingPlanResource:
      type: object
      required:
        [
          _links,
          id,
          storyId,
          storyRevisionId,
          taskingCandidateId,
          deskCheckDecisionId,
          plan,
          contentSha256,
          approvedByUserId,
          approvedAt,
        ]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        id: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        taskingCandidateId: { type: string }
        deskCheckDecisionId: { type: string }
        plan: { $ref: '#/components/schemas/TaskingCandidateSnapshot' }
        contentSha256: { type: string }
        approvedByUserId: { type: string }
        approvedAt: { type: string, format: date-time }
    TaskingTestDouble:
      type: string
      enum: [fake, stub, spy, mock]
    TaskingReplacedBoundary:
      type: object
      required: [boundary, testDouble]
      properties:
        boundary: { $ref: '#/components/schemas/TaskingTechnicalBoundary' }
        testDouble: { $ref: '#/components/schemas/TaskingTestDouble' }
    TaskingRedContract:
      type: object
      required: [expectedFailureKind, expectedFailure]
      properties:
        expectedFailureKind: { type: string, enum: [behavior] }
        expectedFailure: { type: string }
    TaskingProcessStepDefinition:
      type: object
      required:
        [
          id,
          quadrant,
          purpose,
          red,
          greenDoneWhen,
          refactorDoneWhen,
          functionalContexts,
          realBoundaries,
          replacedBoundaries,
          nearestTestRoots,
          focusedCommandTemplate,
          requiresProject,
        ]
      properties:
        id: { type: string }
        quadrant: { type: string, enum: [Q1, Q2] }
        purpose: { type: string }
        red: { $ref: '#/components/schemas/TaskingRedContract' }
        greenDoneWhen: { type: string }
        refactorDoneWhen: { type: string }
        functionalContexts:
          type: array
          items: { $ref: '#/components/schemas/TaskingFunctionalContext' }
        realBoundaries:
          type: array
          items: { $ref: '#/components/schemas/TaskingTechnicalBoundary' }
        replacedBoundaries:
          type: array
          items: { $ref: '#/components/schemas/TaskingReplacedBoundary' }
        nearestTestRoots:
          type: array
          items: { type: string }
        focusedCommandTemplate: { type: string }
        requiresProject: { type: boolean }
    TaskingQualityGateDefinition:
      type: object
      required: [scope, commandTemplate]
      properties:
        scope:
          { type: string, enum: [test_projects, planned_projects, process] }
        requiredTarget: { type: string }
        commandTemplate: { type: string }
    TaskingProcessDefinition:
      type: object
      required:
        [
          version,
          id,
          owner,
          runtime,
          functionalContexts,
          technicalBoundaries,
          appliesWhen,
          steps,
          qualityGates,
        ]
      properties:
        version: { type: integer, enum: [3] }
        id: { type: string }
        owner: { type: string }
        runtime: { type: string, enum: [java, typescript] }
        functionalContexts:
          type: array
          items: { $ref: '#/components/schemas/TaskingFunctionalContext' }
        technicalBoundaries:
          type: array
          items: { $ref: '#/components/schemas/TaskingTechnicalBoundary' }
        appliesWhen: { type: string }
        steps:
          type: array
          items: { $ref: '#/components/schemas/TaskingProcessStepDefinition' }
        qualityGates:
          type: array
          items: { $ref: '#/components/schemas/TaskingQualityGateDefinition' }
    TaskingResource:
      type: object
      required:
        [
          _links,
          iteration,
          story,
          storyRevision,
          noModelImpactDecision,
          currentCandidate,
          decisions,
          approvedPlan,
          processCatalog,
        ]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        story: { $ref: '#/components/schemas/StoryResource' }
        storyRevision: { $ref: '#/components/schemas/StoryRevisionResource' }
        noModelImpactDecision:
          oneOf:
            - $ref: '#/components/schemas/NoModelImpactDecisionResource'
            - type: 'null'
        currentCandidate:
          oneOf:
            - $ref: '#/components/schemas/TaskingCandidateResource'
            - type: 'null'
        decisions:
          type: array
          items: { $ref: '#/components/schemas/DeskCheckDecisionResource' }
        approvedPlan:
          oneOf:
            - $ref: '#/components/schemas/ApprovedTaskingPlanResource'
            - type: 'null'
        processCatalog:
          type: array
          items: { $ref: '#/components/schemas/TaskingProcessDefinition' }
    DeskCheckDecisionResultResource:
      type: object
      required: [_links, iteration, decision, approvedPlan]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        decision: { $ref: '#/components/schemas/DeskCheckDecisionResource' }
        approvedPlan:
          oneOf:
            - $ref: '#/components/schemas/ApprovedTaskingPlanResource'
            - type: 'null'
    PairStatus:
      type: string
      enum: [running, approval_required, approved, exception, cancelled]
    PairCheckpoint:
      type: string
      enum:
        [
          plan_confirmed,
          test_written,
          red_observed,
          implementation_written,
          green_observed,
          refactored,
          quality_gate_failed,
          quality_gates_passed,
          approved,
          exception,
        ]
    PairDriverRole:
      type: string
      enum: [test, production, refactor]
    PairDriverMode:
      type: string
      enum:
        [
          write_test,
          repair_test,
          implement,
          repair_implementation,
          refactor,
          repair_refactor,
          repair_quality_gate,
        ]
    PairRepairMode:
      type: string
      enum:
        [
          repair_test,
          repair_implementation,
          repair_refactor,
          repair_quality_gate,
        ]
    PairCommandStage:
      type: string
      enum: [red, green, refactor, quality_gate]
    PairTermination:
      type: string
      enum: [exited, timed_out, signaled, spawn_error]
    PairRedClassification:
      type: string
      enum:
        [behavior, compile, dependency, configuration, network, fixture, other]
    PairExceptionKind:
      type: string
      enum:
        [
          unexpected_green,
          pseudo_red,
          green_failed,
          refactor_failed,
          quality_gate_failed,
          path_violation,
          git_head_changed,
          project_ownership_changed,
          lease_expired,
          interrupted,
          budget_exhausted,
          no_progress,
          evidence_mismatch,
          runtime_failure,
        ]
    PairDecisionAction:
      type: string
      enum:
        [
          approve,
          back_test,
          back_implementation,
          back_tasking,
          retry_quality,
          cancel,
        ]
    PairCursor:
      type: object
      required:
        [
          unitIndex,
          pendingRefactorStepKey,
          refactorVerificationIndex,
          qualityGateIndex,
          repairMode,
          repairDiagnosticObservationId,
          repairDecisionId,
          repairInstruction,
        ]
      properties:
        unitIndex: { type: integer, minimum: 0 }
        pendingRefactorStepKey: { type: [string, 'null'] }
        refactorVerificationIndex: { type: integer, minimum: 0 }
        qualityGateIndex: { type: integer, minimum: 0 }
        repairMode:
          oneOf:
            - $ref: '#/components/schemas/PairRepairMode'
            - type: 'null'
        repairDiagnosticObservationId: { type: [string, 'null'] }
        repairDecisionId: { type: [string, 'null'] }
        repairInstruction: { type: [string, 'null'], maxLength: 2000 }
    PairBudgetUsage:
      type: object
      required:
        [
          agentCalls,
          checkpoints,
          repeatedFingerprintCount,
          noProgressCheckpoints,
        ]
      properties:
        agentCalls: { type: integer, minimum: 0 }
        checkpoints: { type: integer, minimum: 0 }
        repeatedFingerprintCount: { type: integer, minimum: 0 }
        noProgressCheckpoints: { type: integer, minimum: 0 }
    PairRunResource:
      type: object
      required:
        [
          id,
          reference,
          workspaceId,
          iterationId,
          storyId,
          storyRevisionId,
          storyRevisionSha256,
          approvedTaskingPlanId,
          approvedTaskingPlanSha256,
          baseCommitSha,
          branchName,
          status,
          checkpoint,
          version,
          cursor,
          completedTestIds,
          completedStepKeys,
          executionBudget,
          budgetUsage,
          leaseOwnerId,
          leaseExpiresAt,
          currentDiffSha256,
          finalManifestSha256,
          approvedCommitSha,
          startedAt,
          updatedAt,
          completedAt,
        ]
      properties:
        id: { type: string }
        reference: { type: string, pattern: '^PAIR-[0-9]{4,}$' }
        workspaceId: { type: string }
        iterationId: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        storyRevisionSha256: { type: string }
        approvedTaskingPlanId: { type: string }
        approvedTaskingPlanSha256: { type: string }
        baseCommitSha: { type: string }
        branchName: { type: string }
        status: { $ref: '#/components/schemas/PairStatus' }
        checkpoint: { $ref: '#/components/schemas/PairCheckpoint' }
        version: { type: integer, minimum: 1 }
        cursor: { $ref: '#/components/schemas/PairCursor' }
        completedTestIds:
          type: array
          items: { type: string }
        completedStepKeys:
          type: array
          items: { type: string }
        executionBudget: { $ref: '#/components/schemas/PairExecutionBudget' }
        budgetUsage: { $ref: '#/components/schemas/PairBudgetUsage' }
        leaseOwnerId: { type: [string, 'null'] }
        leaseExpiresAt: { type: [string, 'null'], format: date-time }
        currentDiffSha256: { type: [string, 'null'] }
        finalManifestSha256: { type: [string, 'null'] }
        approvedCommitSha: { type: [string, 'null'] }
        startedAt: { type: string, format: date-time }
        updatedAt: { type: string, format: date-time }
        completedAt: { type: [string, 'null'], format: date-time }
    PairWorkUnit:
      type: object
      required:
        [
          index,
          stepKey,
          task,
          test,
          process,
          step,
          focusedCommand,
          testRoots,
          productionRoots,
        ]
      properties:
        index: { type: integer, minimum: 0 }
        stepKey: { type: string }
        task: { $ref: '#/components/schemas/TaskingTaskResource' }
        test: { $ref: '#/components/schemas/TaskingTestResource' }
        process: { $ref: '#/components/schemas/TaskingProcessSelection' }
        step: { $ref: '#/components/schemas/TaskingProcessStepDefinition' }
        focusedCommand:
          type: object
          required: [command, projectId]
          properties:
            command: { type: string }
            projectId: { type: [string, 'null'] }
        testRoots:
          type: array
          items: { type: string }
        productionRoots:
          type: array
          items: { type: string }
    PairQualityGate:
      type: object
      required: [index, processId, projectId, target, command]
      properties:
        index: { type: integer, minimum: 0 }
        processId: { type: string }
        projectId: { type: [string, 'null'] }
        target: { type: [string, 'null'] }
        command: { type: string }
    PairActionAuthority:
      type: object
      required: [actionId, expectedPairVersion]
      properties:
        actionId: { type: string }
        expectedPairVersion: { type: integer, minimum: 1 }
    PairRunDriverAction:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthority'
        - type: object
          required:
            [
              kind,
              role,
              mode,
              workUnit,
              stepKey,
              allowedTestRoots,
              allowedProductionRoots,
              frozenTestPaths,
              diagnosticObservationId,
              repairDecisionId,
              repairInstruction,
            ]
          properties:
            kind: { type: string, enum: [run_driver] }
            role: { $ref: '#/components/schemas/PairDriverRole' }
            mode: { $ref: '#/components/schemas/PairDriverMode' }
            workUnit:
              oneOf:
                - $ref: '#/components/schemas/PairWorkUnit'
                - type: 'null'
            stepKey: { type: [string, 'null'] }
            allowedTestRoots:
              type: array
              items: { type: string }
            allowedProductionRoots:
              type: array
              items: { type: string }
            frozenTestPaths:
              type: array
              items: { type: string }
            diagnosticObservationId: { type: [string, 'null'] }
            repairDecisionId: { type: [string, 'null'] }
            repairInstruction: { type: [string, 'null'], maxLength: 2000 }
    PairExecuteCommandAction:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthority'
        - type: object
          required: [kind, stage, workUnit, gate, command, timeoutMs]
          properties:
            kind: { type: string, enum: [execute_command] }
            stage: { $ref: '#/components/schemas/PairCommandStage' }
            workUnit:
              oneOf:
                - $ref: '#/components/schemas/PairWorkUnit'
                - type: 'null'
            gate:
              oneOf:
                - $ref: '#/components/schemas/PairQualityGate'
                - type: 'null'
            command: { type: string }
            timeoutMs: { type: integer, minimum: 1 }
    PairReviewRedAction:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthority'
        - type: object
          required:
            [
              kind,
              workUnit,
              observationId,
              expectedFailureKind,
              expectedFailure,
            ]
          properties:
            kind: { type: string, enum: [review_red] }
            workUnit: { $ref: '#/components/schemas/PairWorkUnit' }
            observationId: { type: string }
            expectedFailureKind: { type: string, enum: [behavior] }
            expectedFailure: { type: string }
    PairAwaitHumanAction:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthority'
        - type: object
          required: [kind, manifestSha256]
          properties:
            kind: { type: string, enum: [await_human] }
            manifestSha256: { type: string }
    PairResolveExceptionAction:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthority'
        - type: object
          required: [kind, exceptionId, allowedRoutes]
          properties:
            kind: { type: string, enum: [resolve_exception] }
            exceptionId: { type: string }
            allowedRoutes:
              type: array
              items: { $ref: '#/components/schemas/PairDecisionAction' }
    PairNextAction:
      oneOf:
        - $ref: '#/components/schemas/PairRunDriverAction'
        - $ref: '#/components/schemas/PairExecuteCommandAction'
        - $ref: '#/components/schemas/PairReviewRedAction'
        - $ref: '#/components/schemas/PairAwaitHumanAction'
        - $ref: '#/components/schemas/PairResolveExceptionAction'
    PairDriverAttemptResource:
      type: object
      required:
        [
          id,
          pairRunId,
          actionId,
          sequence,
          role,
          mode,
          taskId,
          testId,
          processId,
          stepId,
          summary,
          changedPaths,
          beforeWorktreeSha256,
          afterWorktreeSha256,
          diffSha256,
          agentCallCount,
          inputTokens,
          outputTokens,
          completedAt,
          recordSha256,
        ]
      properties:
        id: { type: string }
        pairRunId: { type: string }
        actionId: { type: string }
        sequence: { type: integer, minimum: 1 }
        role: { $ref: '#/components/schemas/PairDriverRole' }
        mode: { $ref: '#/components/schemas/PairDriverMode' }
        taskId: { type: [string, 'null'] }
        testId: { type: [string, 'null'] }
        processId: { type: [string, 'null'] }
        stepId: { type: [string, 'null'] }
        summary: { type: string }
        changedPaths:
          type: array
          items: { type: string }
        beforeWorktreeSha256: { type: string }
        afterWorktreeSha256: { type: string }
        diffSha256: { type: string }
        agentCallCount: { type: integer, minimum: 1 }
        inputTokens: { type: [integer, 'null'], minimum: 0 }
        outputTokens: { type: [integer, 'null'], minimum: 0 }
        completedAt: { type: string, format: date-time }
        recordSha256: { type: string }
    PairCommandObservationResource:
      type: object
      required:
        [
          id,
          pairRunId,
          actionId,
          sequence,
          stage,
          taskId,
          testId,
          processId,
          stepId,
          command,
          termination,
          exitCode,
          signal,
          durationMs,
          stdoutSha256,
          stdoutBytes,
          stdoutLines,
          stderrSha256,
          stderrBytes,
          stderrLines,
          worktreeSha256,
          diffSha256,
          failureFingerprint,
          observedAt,
          previousRecordSha256,
          recordSha256,
        ]
      properties:
        id: { type: string }
        pairRunId: { type: string }
        actionId: { type: string }
        sequence: { type: integer, minimum: 1 }
        stage: { $ref: '#/components/schemas/PairCommandStage' }
        taskId: { type: [string, 'null'] }
        testId: { type: [string, 'null'] }
        processId: { type: string }
        stepId: { type: [string, 'null'] }
        command: { type: string }
        termination: { $ref: '#/components/schemas/PairTermination' }
        exitCode: { type: [integer, 'null'] }
        signal: { type: [string, 'null'] }
        durationMs: { type: integer, minimum: 0 }
        stdoutSha256: { type: string }
        stdoutBytes: { type: integer, minimum: 0 }
        stdoutLines: { type: integer, minimum: 0 }
        stderrSha256: { type: string }
        stderrBytes: { type: integer, minimum: 0 }
        stderrLines: { type: integer, minimum: 0 }
        worktreeSha256: { type: string }
        diffSha256: { type: string }
        failureFingerprint: { type: [string, 'null'] }
        observedAt: { type: string, format: date-time }
        previousRecordSha256: { type: [string, 'null'] }
        recordSha256: { type: string }
    PairRedReviewResource:
      type: object
      required:
        [
          id,
          pairRunId,
          actionId,
          observationId,
          classification,
          accepted,
          reason,
          reviewedAt,
          recordSha256,
        ]
      properties:
        id: { type: string }
        pairRunId: { type: string }
        actionId: { type: string }
        observationId: { type: string }
        classification: { $ref: '#/components/schemas/PairRedClassification' }
        accepted: { type: boolean }
        reason: { type: string }
        reviewedAt: { type: string, format: date-time }
        recordSha256: { type: string }
    PairAutomationExceptionResource:
      type: object
      required:
        [
          id,
          pairRunId,
          actionId,
          kind,
          summary,
          failureFingerprint,
          allowedRoutes,
          raisedAt,
          resolvedAt,
          recordSha256,
        ]
      properties:
        id: { type: string }
        pairRunId: { type: string }
        actionId: { type: [string, 'null'] }
        kind: { $ref: '#/components/schemas/PairExceptionKind' }
        summary: { type: string }
        failureFingerprint: { type: [string, 'null'] }
        allowedRoutes:
          type: array
          items: { $ref: '#/components/schemas/PairDecisionAction' }
        raisedAt: { type: string, format: date-time }
        resolvedAt: { type: [string, 'null'], format: date-time }
        recordSha256: { type: string }
    PairExecutionManifestResource:
      type: object
      required:
        [
          id,
          pairRunId,
          approvedTaskingPlanSha256,
          storyRevisionSha256,
          baseCommitSha,
          completedTestIds,
          completedStepKeys,
          driverAttemptIds,
          commandObservationIds,
          redReviewIds,
          changedPaths,
          finalDiffSha256,
          evidenceChainSha256,
          generatedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        pairRunId: { type: string }
        approvedTaskingPlanSha256: { type: string }
        storyRevisionSha256: { type: string }
        baseCommitSha: { type: string }
        completedTestIds:
          type: array
          items: { type: string }
        completedStepKeys:
          type: array
          items: { type: string }
        driverAttemptIds:
          type: array
          items: { type: string }
        commandObservationIds:
          type: array
          items: { type: string }
        redReviewIds:
          type: array
          items: { type: string }
        changedPaths:
          type: array
          items: { type: string }
        finalDiffSha256: { type: string }
        evidenceChainSha256: { type: string }
        generatedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    PairCodingDecisionResource:
      type: object
      required:
        [
          id,
          pairRunId,
          action,
          reason,
          manifestSha256,
          diffSha256,
          commitSha,
          decidedByUserId,
          decidedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        pairRunId: { type: string }
        action: { $ref: '#/components/schemas/PairDecisionAction' }
        reason: { type: string }
        manifestSha256: { type: [string, 'null'] }
        diffSha256: { type: [string, 'null'] }
        commitSha: { type: [string, 'null'] }
        decidedByUserId: { type: string }
        decidedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    PairResource:
      type: object
      required:
        [
          _links,
          iteration,
          story,
          storyRevision,
          approvedPlan,
          run,
          driverAttempts,
          commandObservations,
          redReviews,
          currentException,
          manifest,
          decisions,
          nextAction,
        ]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        story: { $ref: '#/components/schemas/StoryResource' }
        storyRevision: { $ref: '#/components/schemas/StoryRevisionResource' }
        approvedPlan:
          { $ref: '#/components/schemas/ApprovedTaskingPlanResource' }
        run: { $ref: '#/components/schemas/PairRunResource' }
        driverAttempts:
          type: array
          items: { $ref: '#/components/schemas/PairDriverAttemptResource' }
        commandObservations:
          type: array
          items: { $ref: '#/components/schemas/PairCommandObservationResource' }
        redReviews:
          type: array
          items: { $ref: '#/components/schemas/PairRedReviewResource' }
        currentException:
          oneOf:
            - $ref: '#/components/schemas/PairAutomationExceptionResource'
            - type: 'null'
        manifest:
          oneOf:
            - $ref: '#/components/schemas/PairExecutionManifestResource'
            - type: 'null'
        decisions:
          type: array
          items: { $ref: '#/components/schemas/PairCodingDecisionResource' }
        nextAction:
          oneOf:
            - $ref: '#/components/schemas/PairNextAction'
            - type: 'null'
    StartPairInput:
      type: object
      additionalProperties: false
      required:
        [
          expectedIterationVersion,
          approvedTaskingPlanId,
          approvedTaskingPlanSha256,
          executorId,
        ]
      properties:
        expectedIterationVersion: { type: integer, minimum: 1 }
        approvedTaskingPlanId: { type: string, minLength: 1 }
        approvedTaskingPlanSha256:
          { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        executorId: { type: string, minLength: 1 }
    ClaimPairLeaseInput:
      type: object
      additionalProperties: false
      required: [pairRunId, expectedPairVersion, executorId]
      properties:
        pairRunId: { type: string, minLength: 1 }
        expectedPairVersion: { type: integer, minimum: 1 }
        executorId: { type: string, minLength: 1 }
    HeartbeatPairLeaseInput:
      type: object
      additionalProperties: false
      required: [pairRunId, expectedPairVersion]
      properties:
        pairRunId: { type: string, minLength: 1 }
        expectedPairVersion: { type: integer, minimum: 1 }
    PairActionAuthorityInput:
      type: object
      required: [pairRunId, actionId, expectedPairVersion]
      properties:
        pairRunId: { type: string, minLength: 1 }
        actionId: { type: string, minLength: 1 }
        expectedPairVersion: { type: integer, minimum: 1 }
    RecordPairDriverAttemptInput:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthorityInput'
        - type: object
          required:
            [
              role,
              mode,
              summary,
              changedPaths,
              beforeWorktreeSha256,
              afterWorktreeSha256,
              diffSha256,
              agentCallCount,
            ]
          properties:
            role: { $ref: '#/components/schemas/PairDriverRole' }
            mode: { $ref: '#/components/schemas/PairDriverMode' }
            summary: { type: string, minLength: 1, maxLength: 2000 }
            changedPaths:
              type: array
              items: { type: string }
            beforeWorktreeSha256: { type: string }
            afterWorktreeSha256: { type: string }
            diffSha256: { type: string }
            agentCallCount: { type: integer, minimum: 1 }
            inputTokens: { type: [integer, 'null'], minimum: 0 }
            outputTokens: { type: [integer, 'null'], minimum: 0 }
    RecordPairCommandObservationInput:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthorityInput'
        - type: object
          required:
            [
              stage,
              command,
              termination,
              exitCode,
              durationMs,
              stdoutSha256,
              stdoutBytes,
              stdoutLines,
              stderrSha256,
              stderrBytes,
              stderrLines,
              worktreeSha256,
              diffSha256,
            ]
          properties:
            stage: { $ref: '#/components/schemas/PairCommandStage' }
            command: { type: string, minLength: 1 }
            termination: { $ref: '#/components/schemas/PairTermination' }
            exitCode: { type: [integer, 'null'] }
            signal: { type: [string, 'null'] }
            durationMs: { type: integer, minimum: 0 }
            stdoutSha256: { type: string }
            stdoutBytes: { type: integer, minimum: 0 }
            stdoutLines: { type: integer, minimum: 0 }
            stderrSha256: { type: string }
            stderrBytes: { type: integer, minimum: 0 }
            stderrLines: { type: integer, minimum: 0 }
            worktreeSha256: { type: string }
            diffSha256: { type: string }
    RecordPairRedReviewInput:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthorityInput'
        - type: object
          required: [observationId, classification, reason]
          properties:
            observationId: { type: string, minLength: 1 }
            classification:
              { $ref: '#/components/schemas/PairRedClassification' }
            reason: { type: string, minLength: 1, maxLength: 2000 }
    RecordPairExceptionInput:
      allOf:
        - $ref: '#/components/schemas/PairActionAuthorityInput'
        - type: object
          required: [kind, summary]
          properties:
            kind: { $ref: '#/components/schemas/PairExceptionKind' }
            summary: { type: string, minLength: 1, maxLength: 2000 }
            failureFingerprint: { type: [string, 'null'] }
    DecidePairInput:
      type: object
      additionalProperties: false
      required: [expectedPairVersion, action, reason]
      properties:
        expectedPairVersion: { type: integer, minimum: 1 }
        action: { $ref: '#/components/schemas/PairDecisionAction' }
        reason: { type: string, minLength: 1, maxLength: 2000 }
        manifestSha256: { type: [string, 'null'] }
        diffSha256: { type: [string, 'null'] }
        commitSha: { type: [string, 'null'] }
    StartPairResultResource:
      type: object
      required: [_links, pair, leaseToken]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        pair: { $ref: '#/components/schemas/PairResource' }
        leaseToken: { type: string }
    ClaimPairLeaseResult:
      type: object
      required: [run, leaseToken]
      properties:
        run: { $ref: '#/components/schemas/PairRunResource' }
        leaseToken: { type: string }
    PairActionResultResource:
      type: object
      required: [_links, pair, acceptedRecordId]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        pair: { $ref: '#/components/schemas/PairResource' }
        acceptedRecordId: { type: string }
    ShowcaseStage:
      type: string
      enum: [setup, reviewing, decision, accepted, revised, rejected]
    ShowcaseQuadrant:
      type: string
      enum: [Q3, Q4]
    ShowcaseRiskDisposition:
      type: string
      enum: [required, not_required]
    ShowcaseRiskActivity:
      type: string
      enum:
        [
          exploratory,
          usability,
          accessibility,
          compatibility,
          performance,
          security,
          reliability,
          operability,
          other,
        ]
    ShowcaseEvaluationOutcome:
      type: string
      enum: [passed, concern]
    ShowcaseReviewRecommendation:
      type: string
      enum: [accept, revise]
    ShowcaseDecisionAction:
      type: string
      enum: [accept, revise, reject]
    ShowcaseFeedbackTarget:
      type: string
      enum:
        [
          problem,
          story,
          business_knowledge,
          scenario,
          model,
          modeling_method,
          architecture,
          test_strategy,
          test_process,
          value_validation,
          showcase_setup,
        ]
    ShowcaseRunResource:
      type: object
      required:
        [
          id,
          reference,
          attempt,
          workspaceId,
          iterationId,
          storyId,
          storyRevisionId,
          storyRevisionSha256,
          approvedTaskingPlanId,
          approvedTaskingPlanSha256,
          pairRunId,
          pairManifestId,
          pairManifestSha256,
          approvedCommitSha,
          stage,
          version,
          evidenceBundleSha256,
          startedAt,
          updatedAt,
          completedAt,
        ]
      properties:
        id: { type: string }
        reference: { type: string, pattern: '^SHOW-[0-9]{4,}$' }
        attempt: { type: integer, minimum: 1 }
        workspaceId: { type: string }
        iterationId: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        storyRevisionSha256: { type: string }
        approvedTaskingPlanId: { type: string }
        approvedTaskingPlanSha256: { type: string }
        pairRunId: { type: string }
        pairManifestId: { type: string }
        pairManifestSha256: { type: string }
        approvedCommitSha: { type: string }
        stage: { $ref: '#/components/schemas/ShowcaseStage' }
        version: { type: integer, minimum: 1 }
        evidenceBundleSha256: { type: [string, 'null'] }
        startedAt: { type: string, format: date-time }
        updatedAt: { type: string, format: date-time }
        completedAt: { type: [string, 'null'], format: date-time }
    ShowcaseQ2ObservationResource:
      type: object
      required:
        [
          id,
          showcaseRunId,
          actionId,
          sequence,
          testId,
          scenarioIds,
          processId,
          stepId,
          projectId,
          command,
          termination,
          exitCode,
          signal,
          durationMs,
          stdoutSha256,
          stdoutBytes,
          stdoutLines,
          stderrSha256,
          stderrBytes,
          stderrLines,
          approvedCommitSha,
          worktreeSha256,
          observedAt,
          previousRecordSha256,
          recordSha256,
        ]
      properties:
        id: { type: string }
        showcaseRunId: { type: string }
        actionId: { type: string }
        sequence: { type: integer, minimum: 1 }
        testId: { type: string }
        scenarioIds: { type: array, items: { type: string } }
        processId: { type: string }
        stepId: { type: string }
        projectId: { type: [string, 'null'] }
        command: { type: string }
        termination: { $ref: '#/components/schemas/PairTermination' }
        exitCode: { type: [integer, 'null'] }
        signal: { type: [string, 'null'] }
        durationMs: { type: integer, minimum: 0 }
        stdoutSha256: { type: string }
        stdoutBytes: { type: integer, minimum: 0 }
        stdoutLines: { type: integer, minimum: 0 }
        stderrSha256: { type: string }
        stderrBytes: { type: integer, minimum: 0 }
        stderrLines: { type: integer, minimum: 0 }
        approvedCommitSha: { type: string }
        worktreeSha256: { type: string }
        observedAt: { type: string, format: date-time }
        previousRecordSha256: { type: [string, 'null'] }
        recordSha256: { type: string }
    ShowcaseProductObservationResource:
      type: object
      required:
        [
          id,
          showcaseRunId,
          scenarioId,
          scenarioReference,
          givenSteps,
          whenStep,
          expectedThenSteps,
          businessData,
          observedOutcomes,
          observation,
          valueFeedback,
          evidenceRefs,
          observedByUserId,
          observedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        showcaseRunId: { type: string }
        scenarioId: { type: string }
        scenarioReference: { type: string }
        givenSteps: { type: array, items: { type: string } }
        whenStep: { type: string }
        expectedThenSteps: { type: array, items: { type: string } }
        businessData: { type: array, items: { type: string } }
        observedOutcomes: { type: array, items: { type: string } }
        observation: { type: string }
        valueFeedback: { type: string }
        evidenceRefs: { type: array, items: { type: string } }
        observedByUserId: { type: string }
        observedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    ShowcaseRiskDecisionResource:
      type: object
      required:
        [
          id,
          showcaseRunId,
          quadrant,
          disposition,
          activities,
          reason,
          decidedByUserId,
          decidedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        showcaseRunId: { type: string }
        quadrant: { $ref: '#/components/schemas/ShowcaseQuadrant' }
        disposition: { $ref: '#/components/schemas/ShowcaseRiskDisposition' }
        activities:
          type: array
          items: { $ref: '#/components/schemas/ShowcaseRiskActivity' }
        reason: { type: string }
        decidedByUserId: { type: string }
        decidedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    ShowcaseEvaluationResource:
      type: object
      required:
        [
          id,
          showcaseRunId,
          sequence,
          quadrant,
          activity,
          outcome,
          finding,
          evidenceRefs,
          observedByUserId,
          observedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        showcaseRunId: { type: string }
        sequence: { type: integer, minimum: 1 }
        quadrant: { $ref: '#/components/schemas/ShowcaseQuadrant' }
        activity: { $ref: '#/components/schemas/ShowcaseRiskActivity' }
        outcome: { $ref: '#/components/schemas/ShowcaseEvaluationOutcome' }
        finding: { type: string }
        evidenceRefs: { type: array, items: { type: string } }
        observedByUserId: { type: string }
        observedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    ShowcaseReviewResource:
      type: object
      required:
        [
          id,
          showcaseRunId,
          evidenceBundleSha256,
          observedFacts,
          productDomainFeedback,
          technicalQualityFeedback,
          unresolvedAssumptions,
          recommendation,
          reviewedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        showcaseRunId: { type: string }
        evidenceBundleSha256: { type: string }
        observedFacts: { type: array, items: { type: string } }
        productDomainFeedback: { type: array, items: { type: string } }
        technicalQualityFeedback: { type: array, items: { type: string } }
        unresolvedAssumptions: { type: array, items: { type: string } }
        recommendation:
          { $ref: '#/components/schemas/ShowcaseReviewRecommendation' }
        reviewedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    ShowcaseDecisionResource:
      type: object
      required:
        [
          id,
          showcaseRunId,
          action,
          reason,
          feedbackTarget,
          evidenceBundleSha256,
          reviewId,
          decidedByUserId,
          decidedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        showcaseRunId: { type: string }
        action: { $ref: '#/components/schemas/ShowcaseDecisionAction' }
        reason: { type: string }
        feedbackTarget:
          oneOf:
            - $ref: '#/components/schemas/ShowcaseFeedbackTarget'
            - type: 'null'
        evidenceBundleSha256: { type: [string, 'null'] }
        reviewId: { type: [string, 'null'] }
        decidedByUserId: { type: string }
        decidedAt: { type: string, format: date-time }
        contentSha256: { type: string }
    ShowcaseActionAuthority:
      type: object
      required: [actionId, expectedShowcaseVersion]
      properties:
        actionId: { type: string }
        expectedShowcaseVersion: { type: integer, minimum: 1 }
    ShowcaseExecuteQ2Action:
      allOf:
        - $ref: '#/components/schemas/ShowcaseActionAuthority'
        - type: object
          required:
            [
              kind,
              testId,
              scenarioIds,
              processId,
              stepId,
              projectId,
              command,
              timeoutMs,
              approvedCommitSha,
            ]
          properties:
            kind: { type: string, enum: [execute_q2] }
            testId: { type: string }
            scenarioIds: { type: array, items: { type: string } }
            processId: { type: string }
            stepId: { type: string }
            projectId: { type: [string, 'null'] }
            command: { type: string }
            timeoutMs: { type: integer, minimum: 1 }
            approvedCommitSha: { type: string }
    ShowcaseObserveScenarioAction:
      allOf:
        - $ref: '#/components/schemas/ShowcaseActionAuthority'
        - type: object
          required: [kind, scenarioId, scenarioReference]
          properties:
            kind: { type: string, enum: [observe_scenario] }
            scenarioId: { type: string }
            scenarioReference: { type: string }
    ShowcaseDecideRiskAction:
      allOf:
        - $ref: '#/components/schemas/ShowcaseActionAuthority'
        - type: object
          required: [kind, quadrant]
          properties:
            kind: { type: string, enum: [decide_risk] }
            quadrant: { $ref: '#/components/schemas/ShowcaseQuadrant' }
    ShowcaseEvaluateRiskAction:
      allOf:
        - $ref: '#/components/schemas/ShowcaseActionAuthority'
        - type: object
          required: [kind, quadrant, activity]
          properties:
            kind: { type: string, enum: [evaluate_risk] }
            quadrant: { $ref: '#/components/schemas/ShowcaseQuadrant' }
            activity: { $ref: '#/components/schemas/ShowcaseRiskActivity' }
    ShowcaseRunReviewerAction:
      allOf:
        - $ref: '#/components/schemas/ShowcaseActionAuthority'
        - type: object
          required: [kind, evidenceBundleSha256]
          properties:
            kind: { type: string, enum: [run_reviewer] }
            evidenceBundleSha256: { type: string }
    ShowcaseAwaitHumanAction:
      allOf:
        - $ref: '#/components/schemas/ShowcaseActionAuthority'
        - type: object
          required: [kind, reviewId, reviewSha256]
          properties:
            kind: { type: string, enum: [await_human] }
            reviewId: { type: string }
            reviewSha256: { type: string }
    ShowcaseResolveFailureAction:
      allOf:
        - $ref: '#/components/schemas/ShowcaseActionAuthority'
        - type: object
          required: [kind, observationId, allowedActions]
          properties:
            kind: { type: string, enum: [resolve_failure] }
            observationId: { type: string }
            allowedActions:
              type: array
              items: { type: string, enum: [revise, reject] }
    ShowcaseNextAction:
      oneOf:
        - $ref: '#/components/schemas/ShowcaseExecuteQ2Action'
        - $ref: '#/components/schemas/ShowcaseObserveScenarioAction'
        - $ref: '#/components/schemas/ShowcaseDecideRiskAction'
        - $ref: '#/components/schemas/ShowcaseEvaluateRiskAction'
        - $ref: '#/components/schemas/ShowcaseRunReviewerAction'
        - $ref: '#/components/schemas/ShowcaseAwaitHumanAction'
        - $ref: '#/components/schemas/ShowcaseResolveFailureAction'
    ShowcaseResource:
      type: object
      required:
        [
          _links,
          iteration,
          story,
          storyRevision,
          approvedPlan,
          pairRun,
          pairManifest,
          run,
          q2Observations,
          productObservations,
          riskDecisions,
          evaluations,
          review,
          decision,
          nextAction,
        ]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        story: { $ref: '#/components/schemas/StoryResource' }
        storyRevision: { $ref: '#/components/schemas/StoryRevisionResource' }
        approvedPlan:
          { $ref: '#/components/schemas/ApprovedTaskingPlanResource' }
        pairRun: { $ref: '#/components/schemas/PairRunResource' }
        pairManifest:
          { $ref: '#/components/schemas/PairExecutionManifestResource' }
        run: { $ref: '#/components/schemas/ShowcaseRunResource' }
        q2Observations:
          type: array
          items: { $ref: '#/components/schemas/ShowcaseQ2ObservationResource' }
        productObservations:
          type: array
          items:
            { $ref: '#/components/schemas/ShowcaseProductObservationResource' }
        riskDecisions:
          type: array
          items: { $ref: '#/components/schemas/ShowcaseRiskDecisionResource' }
        evaluations:
          type: array
          items: { $ref: '#/components/schemas/ShowcaseEvaluationResource' }
        review:
          oneOf:
            - $ref: '#/components/schemas/ShowcaseReviewResource'
            - type: 'null'
        decision:
          oneOf:
            - $ref: '#/components/schemas/ShowcaseDecisionResource'
            - type: 'null'
        nextAction:
          oneOf:
            - $ref: '#/components/schemas/ShowcaseNextAction'
            - type: 'null'
    RecordShowcaseQ2ObservationInput:
      type: object
      additionalProperties: false
      required:
        [
          showcaseRunId,
          actionId,
          expectedShowcaseVersion,
          command,
          termination,
          exitCode,
          durationMs,
          stdoutSha256,
          stdoutBytes,
          stdoutLines,
          stderrSha256,
          stderrBytes,
          stderrLines,
          approvedCommitSha,
          worktreeSha256,
        ]
      properties:
        showcaseRunId: { type: string, minLength: 1 }
        actionId: { type: string, minLength: 1 }
        expectedShowcaseVersion: { type: integer, minimum: 1 }
        command: { type: string, minLength: 1 }
        termination: { $ref: '#/components/schemas/PairTermination' }
        exitCode: { type: [integer, 'null'] }
        signal: { type: [string, 'null'] }
        durationMs: { type: integer, minimum: 0 }
        stdoutSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        stdoutBytes: { type: integer, minimum: 0 }
        stdoutLines: { type: integer, minimum: 0 }
        stderrSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        stderrBytes: { type: integer, minimum: 0 }
        stderrLines: { type: integer, minimum: 0 }
        approvedCommitSha:
          { type: string, pattern: '^[a-f0-9]{40}(?:[a-f0-9]{24})?$' }
        worktreeSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
    RecordShowcaseProductObservationInput:
      type: object
      additionalProperties: false
      required:
        [
          expectedShowcaseVersion,
          scenarioId,
          observedOutcomes,
          observation,
          valueFeedback,
          evidenceRefs,
        ]
      properties:
        expectedShowcaseVersion: { type: integer, minimum: 1 }
        scenarioId: { type: string, minLength: 1 }
        observedOutcomes:
          { type: array, minItems: 1, items: { type: string, minLength: 1 } }
        observation: { type: string, minLength: 1, maxLength: 4000 }
        valueFeedback: { type: string, minLength: 1, maxLength: 4000 }
        evidenceRefs:
          { type: array, minItems: 1, items: { type: string, minLength: 1 } }
    RecordShowcaseRiskDecisionInput:
      type: object
      additionalProperties: false
      required:
        [expectedShowcaseVersion, quadrant, disposition, activities, reason]
      properties:
        expectedShowcaseVersion: { type: integer, minimum: 1 }
        quadrant: { $ref: '#/components/schemas/ShowcaseQuadrant' }
        disposition: { $ref: '#/components/schemas/ShowcaseRiskDisposition' }
        activities:
          type: array
          items: { $ref: '#/components/schemas/ShowcaseRiskActivity' }
        reason: { type: string, minLength: 1, maxLength: 4000 }
    RecordShowcaseEvaluationInput:
      type: object
      additionalProperties: false
      required:
        [
          expectedShowcaseVersion,
          quadrant,
          activity,
          outcome,
          finding,
          evidenceRefs,
        ]
      properties:
        expectedShowcaseVersion: { type: integer, minimum: 1 }
        quadrant: { $ref: '#/components/schemas/ShowcaseQuadrant' }
        activity: { $ref: '#/components/schemas/ShowcaseRiskActivity' }
        outcome: { $ref: '#/components/schemas/ShowcaseEvaluationOutcome' }
        finding: { type: string, minLength: 1, maxLength: 4000 }
        evidenceRefs:
          { type: array, minItems: 1, items: { type: string, minLength: 1 } }
    RecordShowcaseReviewInput:
      type: object
      additionalProperties: false
      required:
        [
          expectedShowcaseVersion,
          evidenceBundleSha256,
          observedFacts,
          productDomainFeedback,
          technicalQualityFeedback,
          unresolvedAssumptions,
          recommendation,
        ]
      properties:
        expectedShowcaseVersion: { type: integer, minimum: 1 }
        evidenceBundleSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        observedFacts:
          { type: array, minItems: 1, items: { type: string, minLength: 1 } }
        productDomainFeedback:
          { type: array, items: { type: string, minLength: 1 } }
        technicalQualityFeedback:
          { type: array, items: { type: string, minLength: 1 } }
        unresolvedAssumptions:
          { type: array, items: { type: string, minLength: 1 } }
        recommendation:
          { $ref: '#/components/schemas/ShowcaseReviewRecommendation' }
    DecideShowcaseInput:
      type: object
      additionalProperties: false
      required: [expectedShowcaseVersion, action, reason]
      properties:
        expectedShowcaseVersion: { type: integer, minimum: 1 }
        action: { $ref: '#/components/schemas/ShowcaseDecisionAction' }
        reason: { type: string, minLength: 1, maxLength: 4000 }
        evidenceBundleSha256: { type: [string, 'null'] }
        reviewSha256: { type: [string, 'null'] }
        feedbackTarget:
          oneOf:
            - $ref: '#/components/schemas/ShowcaseFeedbackTarget'
            - type: 'null'
    ShowcaseActionResultResource:
      type: object
      required: [_links, showcase, acceptedRecordId]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        showcase: { $ref: '#/components/schemas/ShowcaseResource' }
        acceptedRecordId: { type: string }
    RespondKnowledgeKind:
      type: string
      enum:
        [
          product,
          model,
          architecture,
          contract,
          test_process,
          skill,
          prompt,
          other,
        ]
    RespondPromotionDecision:
      type: string
      enum: [promoted, deferred, rejected]
    RespondDecisionAction:
      type: string
      enum: [approve, revise]
    RespondPromotion:
      type: object
      additionalProperties: false
      required:
        [
          sourceRef,
          kind,
          decision,
          reason,
          validationEvidenceRefs,
          canonicalTarget,
        ]
      properties:
        sourceRef: { type: string, minLength: 1, maxLength: 500 }
        kind: { $ref: '#/components/schemas/RespondKnowledgeKind' }
        decision: { $ref: '#/components/schemas/RespondPromotionDecision' }
        reason: { type: string, minLength: 1, maxLength: 4000 }
        validationEvidenceRefs:
          type: array
          minItems: 1
          maxItems: 50
          items: { type: string, minLength: 1, maxLength: 500 }
        canonicalTarget: { type: [string, 'null'], maxLength: 500 }
    RespondNextProbe:
      type: object
      additionalProperties: false
      required: [question, whyNow, evidenceRefs, firstAction]
      properties:
        question: { type: string, minLength: 1, maxLength: 4000 }
        whyNow: { type: string, minLength: 1, maxLength: 4000 }
        evidenceRefs:
          type: array
          minItems: 1
          maxItems: 50
          items: { type: string, minLength: 1, maxLength: 500 }
        firstAction: { type: string, minLength: 1, maxLength: 4000 }
    RespondAuthority:
      type: object
      required:
        [
          storyRevisionSha256,
          approvedTaskingPlanSha256,
          pairManifestSha256,
          approvedCommitSha,
          showcaseEvidenceBundleSha256,
          showcaseReviewSha256,
          showcaseDecisionSha256,
          authoritySha256,
        ]
      properties:
        storyRevisionSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        approvedTaskingPlanSha256:
          { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        pairManifestSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        approvedCommitSha:
          { type: string, pattern: '^[a-f0-9]{40}(?:[a-f0-9]{24})?$' }
        showcaseEvidenceBundleSha256:
          { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        showcaseReviewSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        showcaseDecisionSha256:
          { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        authoritySha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
    RespondCandidateResource:
      type: object
      required:
        [
          id,
          reference,
          sequence,
          workspaceId,
          iterationId,
          storyId,
          storyRevisionId,
          showcaseRunId,
          showcaseDecisionId,
          authority,
          promotions,
          noPromotionReason,
          observedOutcomes,
          residualRisks,
          nextProbe,
          proposedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        reference: { type: string }
        sequence: { type: integer, minimum: 1 }
        workspaceId: { type: string }
        iterationId: { type: string }
        storyId: { type: string }
        storyRevisionId: { type: string }
        showcaseRunId: { type: string }
        showcaseDecisionId: { type: string }
        authority: { $ref: '#/components/schemas/RespondAuthority' }
        promotions:
          type: array
          items: { $ref: '#/components/schemas/RespondPromotion' }
        noPromotionReason: { type: [string, 'null'] }
        observedOutcomes:
          type: array
          items: { type: string }
        residualRisks:
          type: array
          items: { type: string }
        nextProbe: { $ref: '#/components/schemas/RespondNextProbe' }
        proposedAt: { type: string, format: date-time }
        contentSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
    RespondDecisionResource:
      type: object
      required:
        [
          id,
          candidateId,
          action,
          reason,
          candidateSha256,
          authoritySha256,
          decidedByUserId,
          decidedAt,
          contentSha256,
        ]
      properties:
        id: { type: string }
        candidateId: { type: string }
        action: { $ref: '#/components/schemas/RespondDecisionAction' }
        reason: { type: string }
        candidateSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        authoritySha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        decidedByUserId: { type: string }
        decidedAt: { type: string, format: date-time }
        contentSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
    RespondActionAuthority:
      type: object
      required: [actionId, expectedIterationVersion, authoritySha256]
      properties:
        actionId: { type: string }
        expectedIterationVersion: { type: integer, minimum: 1 }
        authoritySha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
    RespondRunLearnerAction:
      allOf:
        - $ref: '#/components/schemas/RespondActionAuthority'
        - type: object
          required: [kind, showcaseRunId, showcaseDecisionId]
          properties:
            kind: { type: string, enum: [run_learner] }
            showcaseRunId: { type: string }
            showcaseDecisionId: { type: string }
    RespondAwaitHumanAction:
      allOf:
        - $ref: '#/components/schemas/RespondActionAuthority'
        - type: object
          required: [kind, candidateId, candidateSha256]
          properties:
            kind: { type: string, enum: [await_human] }
            candidateId: { type: string }
            candidateSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
    RespondNextAction:
      oneOf:
        - $ref: '#/components/schemas/RespondRunLearnerAction'
        - $ref: '#/components/schemas/RespondAwaitHumanAction'
    ProposeRespondCandidateInput:
      type: object
      additionalProperties: false
      required:
        [
          actionId,
          expectedIterationVersion,
          authoritySha256,
          promotions,
          observedOutcomes,
          residualRisks,
          nextProbe,
        ]
      properties:
        actionId: { type: string, minLength: 1 }
        expectedIterationVersion: { type: integer, minimum: 1 }
        authoritySha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        promotions:
          type: array
          maxItems: 50
          items: { $ref: '#/components/schemas/RespondPromotion' }
        noPromotionReason: { type: [string, 'null'], maxLength: 4000 }
        observedOutcomes:
          type: array
          minItems: 1
          maxItems: 50
          items: { type: string, minLength: 1, maxLength: 500 }
        residualRisks:
          type: array
          maxItems: 50
          items: { type: string, minLength: 1, maxLength: 500 }
        nextProbe: { $ref: '#/components/schemas/RespondNextProbe' }
    DecideRespondInput:
      type: object
      additionalProperties: false
      required:
        [
          expectedIterationVersion,
          candidateId,
          candidateSha256,
          authoritySha256,
          action,
          reason,
        ]
      properties:
        expectedIterationVersion: { type: integer, minimum: 1 }
        candidateId: { type: string, minLength: 1 }
        candidateSha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        authoritySha256: { type: string, pattern: '^sha256:[a-f0-9]{64}$' }
        action: { $ref: '#/components/schemas/RespondDecisionAction' }
        reason: { type: string, minLength: 1, maxLength: 4000 }
    RespondResource:
      type: object
      required:
        [
          _links,
          iteration,
          story,
          storyRevision,
          showcaseRun,
          showcaseDecision,
          authority,
          candidates,
          decisions,
          nextAction,
        ]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        iteration: { $ref: '#/components/schemas/IterationResource' }
        story: { $ref: '#/components/schemas/StoryResource' }
        storyRevision: { $ref: '#/components/schemas/StoryRevisionResource' }
        showcaseRun: { $ref: '#/components/schemas/ShowcaseRunResource' }
        showcaseDecision:
          { $ref: '#/components/schemas/ShowcaseDecisionResource' }
        authority: { $ref: '#/components/schemas/RespondAuthority' }
        candidates:
          type: array
          items: { $ref: '#/components/schemas/RespondCandidateResource' }
        decisions:
          type: array
          items: { $ref: '#/components/schemas/RespondDecisionResource' }
        nextAction:
          oneOf:
            - $ref: '#/components/schemas/RespondNextAction'
            - type: 'null'
    RespondActionResultResource:
      type: object
      required: [_links, respond, acceptedRecordId]
      properties:
        _links: { $ref: '#/components/schemas/BTreeMap' }
        respond: { $ref: '#/components/schemas/RespondResource' }
        acceptedRecordId: { type: string }
    StoryAuthorityOwner:
      type: string
      enum: [human, agent, none]
    StoryNextAction:
      type: string
      enum:
        - answer_clarification
        - run_understanding_analyst
        - review_scenario_set
        - record_model_impact
        - run_tasking_analyst
        - review_tasking_candidate
        - start_pair
        - run_pair
        - route_pair_exception
        - review_pair_change
        - run_showcase
        - record_showcase_evidence
        - review_showcase
        - decide_showcase
        - run_respond_learner
        - review_respond_candidate
        - none
    StoryWorkflowAuthority:
      type: object
      required: [owner, nextAction]
      properties:
        owner:
          $ref: '#/components/schemas/StoryAuthorityOwner'
        nextAction:
          $ref: '#/components/schemas/StoryNextAction'
    StoryStageCount:
      type: object
      required: [loop, stage, count]
      properties:
        loop:
          type: string
          enum: [kickoff, understand, tasking, pair, showcase, respond]
        stage:
          type: string
          enum:
            [
              candidate_review,
              candidate_drafting,
              tqa,
              scenario_review,
              modeling,
              drafting,
              desk_check,
              knowledge_gap,
              approved,
              plan_confirmed,
              test_written,
              red_observed,
              implementation_written,
              green_observed,
              refactored,
              quality_gate_failed,
              quality_gates_passed,
              exception,
              setup,
              reviewing,
              decision,
              accepted,
              rejected,
            ]
        count:
          type: integer
          format: int32
          minimum: 1
    StoryActionCount:
      type: object
      required: [action, count]
      properties:
        action:
          $ref: '#/components/schemas/StoryNextAction'
        count:
          type: integer
          format: int32
          minimum: 1
    StoryPortfolioSummary:
      type: object
      required: [humanAttention, agentAttention, approved, stages, actions]
      properties:
        humanAttention:
          type: integer
          format: int32
          minimum: 0
        agentAttention:
          type: integer
          format: int32
          minimum: 0
        approved:
          type: integer
          format: int32
          minimum: 0
        stages:
          type: array
          items:
            $ref: '#/components/schemas/StoryStageCount'
        actions:
          type: array
          items:
            $ref: '#/components/schemas/StoryActionCount'
    StoryResource:
      type: object
      required:
        - _links
        - id
        - iterationId
        - iterationReference
        - iterationLifecycle
        - iterationLoop
        - iterationStage
        - reference
        - title
        - goal
        - latestRevisionId
        - latestRevisionNumber
        - latestScenarioCount
        - latestCitationCount
        - pendingClarificationReference
        - authority
        - revisionCount
        - version
        - createdAt
        - updatedAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
        iterationId:
          type: string
        iterationReference:
          type: string
          pattern: '^ITER-[0-9]{4,}$'
        iterationLifecycle:
          type: string
          enum: [provisioning, active, provisioning_failed, halted]
        iterationLoop:
          type: string
          enum: [kickoff, understand, tasking, pair, showcase, respond]
        iterationStage:
          type: string
          enum:
            [
              candidate_review,
              candidate_drafting,
              tqa,
              scenario_review,
              modeling,
              drafting,
              desk_check,
              knowledge_gap,
              approved,
              plan_confirmed,
              test_written,
              red_observed,
              implementation_written,
              green_observed,
              refactored,
              quality_gate_failed,
              quality_gates_passed,
              exception,
              setup,
              reviewing,
              decision,
              accepted,
              rejected,
            ]
        reference:
          type: string
          enum: [US-001]
        title:
          type: string
        goal:
          type: string
        latestRevisionId:
          type: string
        latestRevisionNumber:
          type: integer
          format: int32
          minimum: 1
        latestScenarioCount:
          type: integer
          format: int32
          minimum: 0
        latestCitationCount:
          type: integer
          format: int32
          minimum: 0
        pendingClarificationReference:
          type:
            - string
            - 'null'
          pattern: '^Q-[0-9]{3,}$'
        authority:
          $ref: '#/components/schemas/StoryWorkflowAuthority'
        revisionCount:
          type: integer
          format: int32
          minimum: 1
        version:
          type: integer
          format: int32
          minimum: 1
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time
    StoryCollectionEmbedded:
      type: object
      required:
        - stories
      properties:
        stories:
          type: array
          items:
            $ref: '#/components/schemas/StoryResource'
    StoryCollectionResource:
      type: object
      required:
        - _links
        - _embedded
        - page
        - summary
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        _embedded:
          $ref: '#/components/schemas/StoryCollectionEmbedded'
        page:
          $ref: '#/components/schemas/PageModel'
        summary:
          $ref: '#/components/schemas/StoryPortfolioSummary'
    StoryRevisionResource:
      type: object
      required:
        - _links
        - id
        - revisionNumber
        - title
        - problem
        - role
        - goal
        - value
        - cognitiveMode
        - citations
        - scenarios
        - contentSha256
        - createdByUserId
        - createdAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
        revisionNumber:
          type: integer
          format: int32
          minimum: 1
        title:
          type: string
        problem:
          type: string
        role:
          type: string
        goal:
          type: string
        value:
          type: string
        cognitiveMode:
          $ref: '#/components/schemas/StoryCognitiveMode'
        citations:
          type: array
          items:
            $ref: '#/components/schemas/StoryCitationResource'
        scenarios:
          type: array
          items:
            $ref: '#/components/schemas/StoryScenarioResource'
        contentSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        createdByUserId:
          type: string
        createdAt:
          type: string
          format: date-time
    StoryRevisionCollectionEmbedded:
      type: object
      required:
        - storyRevisions
      properties:
        storyRevisions:
          type: array
          items:
            $ref: '#/components/schemas/StoryRevisionResource'
    StoryRevisionCollectionResource:
