          description: Conflict
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '500':
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
  /api/workspaces/{workspaceId}/logical-relationships/{relationshipId}:
    get:
      tags: []
      operationId: get_logical_relationship
      parameters:
        - name: workspaceId
          in: path
          required: true
          schema:
            type: string
        - name: relationshipId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Logical relationship resource
          content:
            application/vnd.evidence.logical-relationship+json:
              schema:
                $ref: '#/components/schemas/LogicalRelationshipResource'
        '400':
          description: Validation error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '404':
          description: Resource not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '409':
          description: Conflict
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '500':
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
    put:
      tags: []
      operationId: update_logical_relationship
      parameters:
        - name: workspaceId
          in: path
          required: true
          schema:
            type: string
        - name: relationshipId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateLogicalRelationshipInput'
        required: true
      responses:
        '200':
          description: Updated logical relationship
          content:
            application/vnd.evidence.logical-relationship+json:
              schema:
                $ref: '#/components/schemas/LogicalRelationshipResource'
        '400':
          description: Validation error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '404':
          description: Resource not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '409':
          description: Conflict
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '500':
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
    delete:
      tags: []
      operationId: delete_logical_relationship
      parameters:
        - name: workspaceId
          in: path
          required: true
          schema:
            type: string
        - name: relationshipId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Logical relationship delete result
          content:
            application/vnd.evidence.logical-relationship+json:
              schema:
                $ref: '#/components/schemas/DeletedResult'
        '400':
          description: Validation error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '404':
          description: Resource not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '409':
          description: Conflict
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
        '500':
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorBody'
components:
  securitySchemes:
    evidenceAuthorization:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: OIDC JWT access token in hosted mode; local mode may use the configured development bearer value.
  parameters:
    PairLeaseHeader:
      name: X-Evidence-Pair-Lease
      in: header
      required: true
      schema: { type: string, minLength: 1, maxLength: 500 }
      description: Opaque short-lived lease returned only to the Desktop Pair controller.
  responses:
    ValidationError:
      description: Validation error
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorBody'
    ResourceNotFound:
      description: Resource not found within the authenticated Workspace boundary
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorBody'
    ResourceConflict:
      description: Resource version or decision conflict
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorBody'
    InternalError:
      description: Internal server error
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorBody'
  schemas:
    AddMembershipInput:
      type: object
      required:
        - user
      properties:
        role:
          type:
            - string
            - 'null'
        user:
          $ref: '#/components/schemas/RefModel'
    UpdateMembershipInput:
      type: object
      required:
        - role
      properties:
        role:
          type: string
          minLength: 1
    BTreeMap:
      type: object
      additionalProperties:
        type: object
        required:
          - href
        properties:
          href:
            type: string
      propertyNames:
        type: string
    CreateLogicalEntityInput:
      type: object
      required:
        - name
        - type
      properties:
        content:
          type: string
        label:
          type:
            - string
            - 'null'
        name:
          type: string
        subType:
          type:
            - string
            - 'null'
        type:
          $ref: '#/components/schemas/LogicalEntityType'
    CreateLogicalRelationshipInput:
      type: object
      required:
        - source
        - target
      properties:
        label:
          type:
            - string
            - 'null'
        source:
          $ref: '#/components/schemas/RefModel'
        target:
          $ref: '#/components/schemas/RefModel'
    DeletedResult:
      type: object
      required:
        - deleted
      properties:
        deleted:
          type: boolean
    DiagramCollectionEmbedded:
      type: object
      required:
        - diagrams
      properties:
        diagrams:
          type: array
          items:
            $ref: '#/components/schemas/DiagramResource'
    DiagramCollectionResource:
      type: object
      required:
        - _links
        - _templates
        - _embedded
        - page
      properties:
        _embedded:
          $ref: '#/components/schemas/DiagramCollectionEmbedded'
        _links:
          $ref: '#/components/schemas/BTreeMap'
        _templates:
          $ref: '#/components/schemas/BTreeMap'
        page:
          $ref: '#/components/schemas/PageModel'
    DiagramResource:
      type: object
      required:
        - _links
        - _templates
        - id
        - title
        - viewport
        - createdAt
        - updatedAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        _templates:
          $ref: '#/components/schemas/BTreeMap'
        createdAt:
          type: string
        id:
          type: string
        title:
          type: string
        updatedAt:
          type: string
        viewport:
          $ref: '#/components/schemas/Viewport'
    EdgeCollectionEmbedded:
      type: object
      required:
        - edges
      properties:
        edges:
          type: array
          items:
            $ref: '#/components/schemas/EdgeResource'
    EdgeCollectionResource:
      type: object
      required:
        - _links
        - _embedded
      properties:
        _embedded:
          $ref: '#/components/schemas/EdgeCollectionEmbedded'
        _links:
          $ref: '#/components/schemas/BTreeMap'
    EdgeResource:
      type: object
      required:
        - _links
        - id
        - source
        - target
        - style
        - data
        - animated
        - hidden
        - pathOptions
        - createdAt
        - updatedAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        animated:
          type: boolean
        createdAt:
          type: string
        data:
          type: object
          additionalProperties: {}
          propertyNames:
            type: string
        hidden:
          type: boolean
        id:
          type: string
        interactionWidth:
          type:
            - number
            - 'null'
          format: double
        kind:
          type:
            - string
            - 'null'
        logicalRelationship:
          oneOf:
            - type: 'null'
            - $ref: '#/components/schemas/RefModel'
        markerEnd:
          type:
            - object
            - 'null'
          additionalProperties: {}
          propertyNames:
            type: string
        markerStart:
          type:
            - object
            - 'null'
          additionalProperties: {}
          propertyNames:
            type: string
        pathOptions:
          type: object
          additionalProperties: {}
          propertyNames:
            type: string
        source:
          $ref: '#/components/schemas/RefModel'
        sourceHandle:
          type:
            - string
            - 'null'
        style:
          type: object
          additionalProperties: {}
          propertyNames:
            type: string
        target:
          $ref: '#/components/schemas/RefModel'
        targetHandle:
          type:
            - string
            - 'null'
        updatedAt:
          type: string
    ErrorBody:
      type: object
      required:
        - error
      properties:
        error:
          type: string
    HealthResource:
      type: object
      required:
        - _links
        - status
        - service
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        service:
          type: string
        status:
          type: string
    Link:
      type: object
      required:
        - href
      properties:
        href:
          type: string
    LinkedRefModel:
      type: object
      required:
        - _links
        - id
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
    InboxItemCollectionEmbedded:
      type: object
      required:
        - inboxItems
      properties:
        inboxItems:
          type: array
          items:
            $ref: '#/components/schemas/InboxItemResource'
    InboxItemCollectionResource:
      type: object
      required:
        - _links
        - _embedded
        - page
      properties:
        _embedded:
          $ref: '#/components/schemas/InboxItemCollectionEmbedded'
        _links:
          $ref: '#/components/schemas/BTreeMap'
        page:
          $ref: '#/components/schemas/PageModel'
    InboxItemResource:
      type: object
      required:
        - _links
        - id
        - sourceKind
        - externalKey
        - title
        - status
        - latestRevisionId
        - latestRevisionSha256
        - revisionCount
        - version
        - createdAt
        - updatedAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
        sourceKind:
          type: string
        externalKey:
          type: string
        title:
          type: string
        status:
          type: string
          enum:
            - active
            - deferred
            - closed
        latestRevisionId:
          type: string
        latestRevisionSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        revisionCount:
          type: integer
          format: int32
          minimum: 1
        version:
          type: integer
          format: int32
          minimum: 1
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time
    InboxItemStatusInput:
      type: object
      required:
        - status
        - expectedVersion
      properties:
        status:
          type: string
          enum:
            - active
            - deferred
            - closed
        expectedVersion:
          type: integer
          format: int32
          minimum: 1
    InboxRevisionCollectionEmbedded:
      type: object
      required:
        - inboxRevisions
      properties:
        inboxRevisions:
          type: array
          items:
            $ref: '#/components/schemas/InboxRevisionResource'
    InboxRevisionCollectionResource:
      type: object
      required:
        - _links
        - _embedded
        - page
      properties:
        _embedded:
          $ref: '#/components/schemas/InboxRevisionCollectionEmbedded'
        _links:
          $ref: '#/components/schemas/BTreeMap'
        page:
          $ref: '#/components/schemas/PageModel'
    InboxSourceUpdateInput:
      type: object
      required:
        - expectedLatestRevisionSha256
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 200
        body:
          type: string
          minLength: 1
          maxLength: 1048576
        contentType:
          type: string
          enum:
            - text/plain
            - text/markdown
        uri:
          type:
            - string
            - 'null'
          format: uri
        providerMetadata:
          type:
            - object
            - 'null'
          additionalProperties: {}
        sourceUpdatedAt:
          type:
            - string
            - 'null'
          format: date-time
        expectedLatestRevisionSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
    InboxRevisionResource:
      type: object
      required:
        - _links
        - id
        - revisionNumber
        - title
        - body
        - contentType
        - providerMetadata
        - capturedAt
        - contentSha256
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
        revisionNumber:
          type: integer
          format: int32
          minimum: 1
        title:
          type: string
        body:
          type: string
        contentType:
          type: string
          enum:
            - text/plain
            - text/markdown
        uri:
          type:
            - string
            - 'null'
          format: uri
        providerMetadata:
          type: object
          additionalProperties: {}
        sourceUpdatedAt:
          type:
            - string
            - 'null'
          format: date-time
        capturedAt:
          type: string
          format: date-time
        contentSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
    InboxSourceInput:
      type: object
      required:
        - sourceKind
        - externalKey
        - title
        - body
        - contentType
      properties:
        sourceKind:
          type: string
          pattern: '^[a-z][a-z0-9_]*$'
        externalKey:
          type: string
          minLength: 1
          maxLength: 256
        title:
          type: string
          minLength: 1
          maxLength: 200
        body:
          type: string
          minLength: 1
          maxLength: 1048576
        contentType:
          type: string
          enum:
            - text/plain
            - text/markdown
        uri:
          type:
            - string
            - 'null'
          format: uri
        providerMetadata:
          type: object
          additionalProperties: {}
        sourceUpdatedAt:
          type:
            - string
            - 'null'
          format: date-time
    CreateInboxExtractionInput:
      type: object
      required:
        - inboxItemIds
      properties:
        inboxItemIds:
          type: array
          minItems: 1
          maxItems: 5
          uniqueItems: true
          items:
            type: string
            minLength: 1
    InboxCandidateCitationInput:
      type: object
      required:
        - inboxItemId
        - revisionSha256
        - locator
      properties:
        inboxItemId:
          type: string
          minLength: 1
        revisionSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        locator:
          type: string
          minLength: 1
          maxLength: 500
    InboxStoryCandidateInput:
      type: object
      required:
        - title
        - problem
        - role
        - goal
        - value
        - cognitiveMode
        - citations
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 200
        problem:
          type: string
          minLength: 1
          maxLength: 2000
        role:
          type: string
          minLength: 1
          maxLength: 200
        goal:
          type: string
          minLength: 1
          maxLength: 2000
        value:
          type: string
          minLength: 1
          maxLength: 2000
        cognitiveMode:
          type: string
          enum: [clear, complicated, complex]
        citations:
          type: array
          minItems: 1
          maxItems: 20
          items:
            $ref: '#/components/schemas/InboxCandidateCitationInput'
    ProposeInboxCandidatesInput:
      type: object
      required:
        - expectedVersion
        - candidates
      properties:
        expectedVersion:
          type: integer
          format: int32
          minimum: 1
        candidates:
          type: array
          minItems: 1
          maxItems: 5
          items:
            $ref: '#/components/schemas/InboxStoryCandidateInput'
    InboxExtractionSourceResource:
      type: object
      required:
        - inboxItemId
        - inboxRevisionId
        - revisionNumber
        - sourceKind
        - externalKey
        - itemStatus
        - title
        - body
        - contentType
        - providerMetadata
        - capturedAt
        - contentSha256
        - locatorLinks
      properties:
        inboxItemId:
          type: string
        inboxRevisionId:
          type: string
        revisionNumber:
          type: integer
          format: int32
          minimum: 1
        sourceKind:
          type: string
        externalKey:
          type: string
        itemStatus:
          type: string
          enum: [active, deferred, closed]
        title:
          type: string
        body:
          type: string
        contentType:
          type: string
          enum: [text/plain, text/markdown]
        uri:
          type: [string, 'null']
          format: uri
        providerMetadata:
          type: object
          additionalProperties: {}
        sourceUpdatedAt:
          type: [string, 'null']
          format: date-time
        capturedAt:
          type: string
          format: date-time
        contentSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        locatorLinks:
          $ref: '#/components/schemas/BTreeMap'
    InboxExtractionResource:
      type: object
      required:
        - _links
        - id
        - reference
        - status
        - sources
        - version
        - requestedByUserId
        - requestedAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
        reference:
          type: string
          pattern: '^EXTRACT-[0-9]{4,}$'
        status:
          type: string
          enum: [awaiting_agent, completed, failed, cancelled]
        sources:
          type: array
          minItems: 1
          maxItems: 5
          items:
            $ref: '#/components/schemas/InboxExtractionSourceResource'
        version:
          type: integer
          format: int32
          minimum: 1
        requestedByUserId:
          type: string
        requestedAt:
          type: string
          format: date-time
        completedAt:
          type: [string, 'null']
          format: date-time
        failureSummary:
          type: [string, 'null']
    InboxCandidateCitationResource:
      type: object
      required:
        - _links
        - inboxItemId
        - inboxRevisionId
        - revisionNumber
        - revisionSha256
        - locator
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        inboxItemId:
          type: string
        inboxRevisionId:
          type: string
        revisionNumber:
          type: integer
          format: int32
          minimum: 1
        revisionSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        locator:
          type: string
    InboxStoryCandidateResource:
      type: object
      required:
        - _links
        - id
        - reference
        - extractionId
        - title
        - problem
        - role
        - goal
        - value
        - cognitiveMode
        - citations
        - contentSha256
        - status
        - proposedBy
        - proposedAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
        reference:
          type: string
          pattern: '^CAND-[0-9]{4,}$'
        extractionId:
          type: string
        title:
          type: string
        problem:
          type: string
        role:
          type: string
        goal:
          type: string
        value:
          type: string
        cognitiveMode:
          type: string
          enum: [clear, complicated, complex]
        citations:
          type: array
          items:
            $ref: '#/components/schemas/InboxCandidateCitationResource'
        contentSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        status:
          type: string
          enum: [ready, stale, selected, deferred, rejected]
        proposedBy:
          type: string
          enum: [inbox-analyst]
        proposedAt:
          type: string
          format: date-time
        terminalDecisionId:
          type: [string, 'null']
        selectedIterationId:
          type: [string, 'null']
    InboxStoryCandidateCollectionEmbedded:
      type: object
      required:
        - storyCandidates
      properties:
        storyCandidates:
          type: array
          items:
            $ref: '#/components/schemas/InboxStoryCandidateResource'
    InboxCandidateStatus:
      type: string
      enum: [ready, stale, selected, deferred, rejected]
    InboxStoryCandidateCollectionResource:
      type: object
      required:
        - _links
        - _embedded
        - page
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        _embedded:
          $ref: '#/components/schemas/InboxStoryCandidateCollectionEmbedded'
        page:
          $ref: '#/components/schemas/PageModel'
    InboxCandidateDecisionInput:
      type: object
      required:
        - candidateSha256
        - reason
      properties:
        candidateSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        reason:
          type: string
          minLength: 1
          maxLength: 2000
    SelectInboxCandidateInput:
      type: object
      required:
        - candidateSha256
        - baseCommitSha
      properties:
        candidateSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        baseCommitSha:
          type: string
          pattern: '^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$'
    IterationResource:
      type: object
      required:
        - _links
        - id
        - reference
        - sourceCandidateId
        - sourceCandidateSha256
        - lifecycle
        - loop
        - stage
        - lane
        - version
        - baseCommitSha
        - admittedByUserId
        - admittedAt
        - updatedAt
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
        id:
          type: string
        reference:
          type: string
          pattern: '^ITER-[0-9]{4,}$'
        sourceCandidateId:
          type: string
        sourceCandidateSha256:
          type: string
          pattern: '^sha256:[a-f0-9]{64}$'
        lifecycle:
          type: string
          enum: [provisioning, active, provisioning_failed, halted]
        loop:
          type: string
          enum: [kickoff, understand, tasking, pair, showcase, respond]
        stage:
          type: string
          enum:
            [
              candidate_review,
              candidate_drafting,
              tqa,
              scenario_review,
              modeling,
              drafting,
              desk_check,
              knowledge_gap,
              approved,
              plan_confirmed,
              test_written,
              red_observed,
              implementation_written,
              green_observed,
              refactored,
              quality_gate_failed,
              quality_gates_passed,
              exception,
              setup,
              reviewing,
              decision,
              accepted,
              rejected,
            ]
        lane:
          type: string
          enum: [discovery, review]
        version:
          type: integer
          format: int32
          minimum: 1
        baseCommitSha:
          type: string
        branchName:
          type: [string, 'null']
        provisioningFailureSummary:
          type: [string, 'null']
        activeStoryId:
          type: [string, 'null']
        admittedByUserId:
          type: string
        admittedAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time
    CompleteIterationProvisioningInput:
      type: object
      required: [expectedVersion, baseCommitSha, branchName]
      properties:
        expectedVersion:
          type: integer
          format: int32
          minimum: 1
        baseCommitSha:
          type: string
          pattern: '^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$'
        branchName:
          type: string
          pattern: '^evidence/iter-[a-z0-9][a-z0-9-]*$'
    FailIterationProvisioningInput:
      type: object
      required: [expectedVersion, reason]
      properties:
        expectedVersion:
          type: integer
          format: int32
          minimum: 1
        reason:
          type: string
          minLength: 1
          maxLength: 2000
    FrozenCitationResource:
      type: object
      required:
        - _links
        - inboxItemId
        - inboxRevisionId
        - revisionNumber
        - revisionSha256
        - locator
      properties:
        _links:
          $ref: '#/components/schemas/BTreeMap'
