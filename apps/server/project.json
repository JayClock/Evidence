{
  "name": "@evidence/server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server/src",
  "projectType": "application",
  "tags": ["scope:server", "type:nest"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "apps/server/dist",
        "configFile": "apps/server/vite.config.mts",
        "tsConfig": "apps/server/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "build-desktop": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/server/dist-desktop"],
      "options": {
        "command": "pnpm --dir apps/server exec vite build --mode desktop"
      }
    },
    "build-migration": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/server/dist-migration"],
      "options": {
        "command": "pnpm exec esbuild apps/server/src/migration-main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=apps/server/dist-migration/main.cjs --external:pg --external:yaml --sourcemap"
      }
    },
    "migrate-postgres": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-migration"],
      "cache": false,
      "options": {
        "command": "node apps/server/dist-migration/main.cjs"
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/server/dist/package.json",
        "{workspaceRoot}/apps/server/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/server/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "@evidence/server:build",
        "buildTargetOptions": {
          "outputFileName": "main.js"
        },
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@evidence/server:build:development"
        },
        "production": {
          "buildTarget": "@evidence/server:build:production"
        }
      }
    }
  }
}
