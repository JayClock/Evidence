# PostgreSQL connection used by the running Evidence Server.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/evidence"

# Server-owned storage for models created after startup. Desktop paths never go here.
# EVIDENCE_WORKSPACE_STORAGE_ROOT="/var/lib/evidence/workspaces"

# Loopback is the safe default. A non-loopback host requires an authorization value.
EVIDENCE_HOST="127.0.0.1"
# EVIDENCE_API_AUTHORIZATION="Bearer REPLACE_WITH_A_RANDOM_SECRET"
# EVIDENCE_CORS_ORIGINS="https://app.example.com,evidence://app"

# One authenticated product principal per MVP deployment.
EVIDENCE_USER_ID="desktop-user"
EVIDENCE_USER_NAME="Desktop User"
EVIDENCE_USER_EMAIL="desktop@evidence.local"

# Optional session/direct connection used only by Prisma CLI migrations.
# Set this when DATABASE_URL points to a transaction-mode connection pooler.
# DIRECT_URL="postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require"

# One-command override for `pnpm prisma:migrate:deploy`. It has highest priority.
# EVIDENCE_MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/evidence"

# Supabase pooler example (replace PROJECT_REF, REGION, and URL_ENCODED_PASSWORD):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
