{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@evidence/server",
  "projectType": "application",
  "tags": ["scope:server", "type:spring-boot"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "parallelism": false,
      "outputs": ["{projectRoot}/build"],
      "options": {
        "command": "node apps/server-java/scripts/run-gradle.mjs :apps:server-java:build"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/server-java/scripts/run-gradle.mjs :apps:server-java:bootRun"
      }
    },
    "contract-boot-jar": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/server-java/scripts/run-gradle.mjs :apps:server-java:bootJar"
      }
    }
  }
}
