{
  "name": "@evidence/desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "tags": ["scope:desktop", "type:electron", "type:typescript"],
  "implicitDependencies": ["@evidence/web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/desktop/dist"],
      "options": {
        "command": "pnpm exec esbuild apps/desktop/src/main.ts apps/desktop/src/preload.ts apps/desktop/src/agent-runtime.ts --bundle --platform=node --target=node20 --format=cjs --outdir=apps/desktop/dist --external:electron --external:@earendil-works/pi-coding-agent --sourcemap"
      }
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "parallel": true,
        "commands": [
          "pnpm nx build @evidence/desktop --watch",
          "pnpm nx dev @evidence/web --host 127.0.0.1 --port 4200",
          "pnpm --dir apps/desktop exec wait-on dist/main.js http-get://127.0.0.1:4200 && pnpm --dir apps/desktop exec electron ."
        ]
      }
    },
    "package-unpacked": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": "@evidence/web",
          "target": "build"
        }
      ],
      "outputs": ["{workspaceRoot}/apps/desktop/dist/packages"],
      "options": {
        "command": "pnpm --dir apps/desktop exec electron-builder --config electron-builder.yml --dir"
      }
    },
    "package-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["package-unpacked"],
      "options": {
        "command": "node apps/desktop/scripts/package-smoke.mjs"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": "@evidence/web",
          "target": "build"
        }
      ],
      "outputs": ["{workspaceRoot}/apps/desktop/dist/packages"],
      "options": {
        "command": "pnpm --dir apps/desktop exec electron-builder --config electron-builder.yml"
      }
    }
  }
}
