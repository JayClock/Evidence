{
  "name": "@evidence/desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "tags": ["scope:desktop", "type:electron", "type:typescript"],
  "implicitDependencies": ["@evidence/web", "@evidence/server-nest"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/desktop/dist"],
      "options": {
        "command": "pnpm exec esbuild apps/desktop/src/main.ts apps/desktop/src/preload.ts --bundle --platform=node --target=node20 --format=cjs --outdir=apps/desktop/dist --external:electron --sourcemap"
      }
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "parallel": true,
        "commands": [
          "pnpm nx build @evidence/desktop --watch",
          "pnpm nx dev @evidence/web --host 127.0.0.1 --port 4200",
          "pnpm nx serve @evidence/server-nest",
          "pnpm --dir apps/desktop exec wait-on dist/main.js http-get://127.0.0.1:4200 http-get://127.0.0.1:3000/health && pnpm --dir apps/desktop exec electron ."
        ]
      }
    }
  }
}
