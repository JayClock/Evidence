{
  "manifest": {
    "type": "fm_model",
    "schemaVersion": "7.0",
    "id": "subscription",
    "name": "专栏订阅与断更补偿",
    "version": "0.1.0",
    "ruleLanguage": "CEL",
    "entryContextRefs": [
      "context.subscription",
      "context.payment-support",
      "context.course-catalog"
    ],
    "description": "内容订阅履约起点：订阅协议下的付款与内容访问两组履约项，断更补偿作为违约触发的履约项，付款由独立的支付协议上下文支撑。"
  },
