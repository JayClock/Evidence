  "stories": [],
  "rules": [
    {
      "type": "rule",
      "id": "rule.payment-completed",
      "kind": "completion",
      "label": "订阅付款履约完成判断",
      "description": "同一付款申请存在有效期内的付款确认时，订阅付款履约完成。",
      "contextRef": "context.subscription",
      "bindings": {
        "request": {
          "ref": "request.pay-subscription"
        },
        "confirmations": {
          "ref": "confirmation.pay-subscription",
          "cardinality": "many"
        }
      },
      "expression": "confirmations.exists(c, c.confirmed_at >= request.started_at && c.confirmed_at <= request.expired_at)",
      "resultType": "bool"
    },
    {
      "type": "rule",
      "id": "rule.content-access-completed",
      "kind": "completion",
      "label": "内容访问履约完成判断",
      "description": "同一访问申请存在有效期内的放行确认时，内容访问履约完成。",
      "contextRef": "context.subscription",
      "bindings": {
        "request": {
          "ref": "request.content-access"
        },
        "confirmations": {
          "ref": "confirmation.content-unlocked",
          "cardinality": "many"
        }
      },
      "expression": "confirmations.exists(c, c.confirmed_at >= request.started_at && c.confirmed_at <= request.expired_at)",
      "resultType": "bool"
    },
    {
      "type": "rule",
      "id": "rule.refund-completed",
      "kind": "completion",
      "label": "断更退款履约完成判断",
      "description": "同一退款申请存在有效期内的退款完成确认时，断更退款履约完成。",
      "contextRef": "context.subscription",
      "bindings": {
        "request": {
          "ref": "request.discontinue-refund"
        },
        "confirmations": {
          "ref": "confirmation.refund-completed",
          "cardinality": "many"
        }
      },
      "expression": "confirmations.exists(c, c.confirmed_at >= request.started_at && c.confirmed_at <= request.expired_at)",
      "resultType": "bool"
    },
    {
      "type": "rule",
      "id": "rule.charge-completed",
      "kind": "completion",
      "label": "扣款履约完成判断",
      "description": "同一扣款申请存在有效期内的扣款确认时，扣款履约完成。",
      "contextRef": "context.payment-support",
      "bindings": {
        "request": {
