{
  "type": "entity",
  "id": "confirmation.milestone-release",
  "category": "evidence",
  "kind": "fulfillment_confirmation",
  "contextRef": "context.settlement",
  "label": "milestone-release",
  "notes": "escrow's immutable answer to request.milestone-release.",
  "responsibleRoleRef": "role.settlement-escrow",
  "attributes": [
    {
      "name": "id",
      "label": "id",
      "meaning": "Unique immutable business evidence identifier.",
      "valueType": "id",
      "required": true
    },
    {
      "name": "confirmed_at",
      "timeRole": "occurrence",
      "label": "confirmed_at",
      "meaning": "Server-recorded UTC business time; caller may not supply this field.",
      "valueType": "timestamp",
      "required": true,
      "keyData": true
    },
    {
      "name": "gross_amount_minor",
      "label": "gross_amount_minor",
      "meaning": "Gross order value from the seller order evidence. In CNY minor units (fen), never a floating-point yuan amount.",
      "valueType": "int",
      "required": true,
      "keyData": true,
      "derivedByRuleRef": "rule.milestone-release-gross"
    },
    {
      "name": "retention_minor",
      "label": "retention_minor",
      "meaning": "Warranty reserve; half-up rounding of gross multiplied by retention basis points. In CNY minor units (fen), never a floating-point yuan amount.",
      "valueType": "int",
      "required": true,
      "keyData": true,
      "derivedByRuleRef": "rule.milestone-release-retention"
    },
    {
      "name": "late_penalty_minor",
      "label": "late_penalty_minor",
      "meaning": "Half-up late penalty capped to gross minus warranty reserve, so payout cannot be negative. In CNY minor units (fen), never a floating-point yuan amount.",
      "valueType": "int",
      "required": true,
      "keyData": true,
      "derivedByRuleRef": "rule.milestone-release-penalty"
    },
    {
      "name": "payout_minor",
      "label": "payout_minor",
      "meaning": "Final immutable seller payout, gross minus reserve minus capped penalty. In CNY minor units (fen), never a floating-point yuan amount.",
      "valueType": "int",
      "required": true,
      "keyData": true,
      "derivedByRuleRef": "rule.milestone-release-payout"
    }
  ],
  "examples": [
    {
      "label": "milestone-on-time-00-tamper",
      "value": {
        "id": "milestone-on-time-confirmation-milestone-release-00-tamper",
        "confirmed_at": "2026-06-15T00:00:00Z",
        "gross_amount_minor": 1354870,
        "retention_minor": 67744,
        "late_penalty_minor": 0,
        "payout_minor": 1287126
      },
      "test": {
        "flow": "milestone-on-time",
        "tags": [
          "dod",
          "milestone",
          "on-time"
        ],
        "actingRoleRef": "role.settlement-escrow",
        "asOf": "2026-06-15T00:00:00Z",
        "basedOn": [
          "request.milestone-release#milestone-on-time"
        ],
        "expectedStatus": 422,
        "inputs": {
          "id": "milestone-on-time-forged",
          "payout_minor": 999999
        },
        "expect": {
          "$.error": "INVALID_INPUT"
        }
      }
    },
    {
