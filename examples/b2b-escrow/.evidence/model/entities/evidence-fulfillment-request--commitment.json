{
  "type": "entity",
  "id": "request.commitment",
  "category": "evidence",
  "kind": "fulfillment_request",
  "fulfillmentAction": "确认采购订单并承诺履行",
  "contextRef": "context.procurement",
  "label": "履约承诺申请（Commitment Request）",
  "notes": "seller's claim on buyer; expires 48 hours after its server-recorded start.",
  "responsibleRoleRef": "role.procurement-seller",
  "attributes": [
    {
      "name": "id",
      "label": "id",
      "meaning": "Unique immutable business evidence identifier.",
      "valueType": "id",
      "required": true
    },
    {
      "name": "started_at",
      "timeRole": "start",
      "label": "started_at",
      "meaning": "Server-recorded UTC business time; caller may not supply this field.",
      "valueType": "timestamp",
      "required": true,
      "keyData": true
    },
    {
      "name": "expired_at",
      "timeRole": "deadline",
      "label": "expired_at",
      "meaning": "Server-recorded UTC business time; caller may not supply this field.",
      "valueType": "timestamp",
      "required": true,
      "keyData": true,
      "derivedByRuleRef": "rule.commitment-expiry"
    }
  ],
  "examples": [
