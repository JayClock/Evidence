      "label": "single-on-time",
      "value": {
        "id": "single-on-time-request-commitment",
        "started_at": "2026-06-01T00:02:00Z",
        "expired_at": "2026-06-03T00:02:00Z"
      },
      "test": {
        "flow": "single-on-time",
