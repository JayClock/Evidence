{
  "type": "rule",
  "id": "rule.milestone-release-gross",
  "kind": "derivation",
  "label": "milestone-release-gross",
  "description": "Settlement consumes immutable order evidence, never caller-supplied financial results.",
  "contextRef": "context.settlement",
  "bindings": {
    "order": {
      "ref": "confirmation.order"
    }
  },
  "expression": "order.gross_amount_minor",
  "resultType": "int",
  "target": {
    "entityRef": "confirmation.milestone-release",
    "attribute": "gross_amount_minor"
  }
}
