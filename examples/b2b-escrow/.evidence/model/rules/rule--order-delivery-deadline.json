{
  "type": "rule",
  "id": "rule.order-delivery-deadline",
  "kind": "derivation",
  "label": "order-delivery-deadline",
  "description": "Seller order evidence preserves the agreed term for cross-context consumers.",
  "contextRef": "context.procurement",
  "bindings": {
    "agreement": {
      "ref": "contract.agreement"
    }
  },
  "expression": "agreement.delivery_deadline",
  "resultType": "timestamp",
  "target": {
    "entityRef": "confirmation.order",
    "attribute": "delivery_deadline"
  }
}
