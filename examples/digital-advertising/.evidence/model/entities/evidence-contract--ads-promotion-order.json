{
  "type": "entity",
  "id": "contract.ads-promotion-order",
  "category": "evidence",
  "kind": "contract",
  "label": "数字广告投放",
  "contextRef": "context.advertising-order",
  "roleRefs": [
    "role.advertiser",
    "role.agency"
  ],
  "attributes": [
    {
      "name": "id",
      "label": "凭证标识",
      "valueType": "id",
      "required": true,
      "meaning": "在此业务凭证类型中唯一的标识"
    },
    {
      "name": "signed_at",
      "timeRole": "occurrence",
      "label": "签署时刻",
      "valueType": "timestamp",
      "required": true,
      "meaning": "签署时刻",
      "keyData": true
    },
    {
      "name": "campaign_id",
      "label": "广告活动",
      "valueType": "id",
      "required": true,
      "meaning": "广告活动"
    },
    {
      "name": "agreed_amount_minor",
      "label": "约定投放总价",
      "valueType": "int",
      "required": true,
      "meaning": "约定投放总价，单位为 CNY 分"
    }
  ],
  "examples": [
    {
      "label": "payment-order",
      "value": {
        "id": "ads-order-pay",
        "campaign_id": "campaign-pay",
        "agreed_amount_minor": 250000,
        "signed_at": "2026-06-01T09:00:00Z"
      },
      "test": {
        "flow": "prepayment-only",
        "actingRoleRef": "role.advertiser",
        "asOf": "2026-06-01T09:00:00Z"
      }
    },
    {
      "label": "sign-campaign-order",
      "value": {
        "id": "ads-order-summer",
        "campaign_id": "campaign-summer",
        "agreed_amount_minor": 720000,
        "signed_at": "2026-07-01T11:00:00Z"
      },
      "test": {
        "flow": "negotiation-to-daily-report",
        "actingRoleRef": "role.advertiser",
        "asOf": "2026-07-01T11:00:00Z",
        "basedOn": [
          "proposal.ads-promotion-proposal#return-quote"
        ]
      }
    }
  ]
}
