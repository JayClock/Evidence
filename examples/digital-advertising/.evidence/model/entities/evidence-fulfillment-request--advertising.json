{
  "type": "entity",
  "id": "request.advertising",
  "category": "evidence",
  "kind": "fulfillment_request",
  "label": "广告上线申请",
  "contextRef": "context.advertising-order",
  "responsibleRoleRef": "role.advertiser",
  "attributes": [
    {
      "name": "id",
      "label": "凭证标识",
      "valueType": "id",
      "required": true,
      "meaning": "在此业务凭证类型中唯一的标识"
    },
    {
      "name": "started_at",
      "timeRole": "start",
      "label": "开启时刻",
      "valueType": "timestamp",
      "required": true,
      "meaning": "开启时刻",
      "keyData": true
    },
    {
      "name": "expired_at",
      "timeRole": "deadline",
      "label": "截止时刻",
      "valueType": "timestamp",
      "required": true,
      "meaning": "截止时刻",
      "keyData": true,
      "derivedByRuleRef": "rule.request.advertising-deadline"
    },
    {
      "name": "placement",
      "label": "投放版位",
      "valueType": "string",
      "required": true,
      "meaning": "投放版位"
    }
  ],
  "examples": [
    {
      "label": "request-launch",
      "value": {
        "id": "launch-request-summer",
        "placement": "首页推荐位",
        "started_at": "2026-07-01T13:00:00Z",
        "expired_at": "2026-07-03T13:00:00Z"
      },
      "test": {
        "flow": "negotiation-to-daily-report",
        "actingRoleRef": "role.advertiser",
        "asOf": "2026-07-01T13:00:00Z",
        "basedOn": [
          "confirmation.payment#summer-payment-proof"
        ]
      }
    }
  ]
}
