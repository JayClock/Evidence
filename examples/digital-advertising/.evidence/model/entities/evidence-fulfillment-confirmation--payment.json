{
  "type": "entity",
  "id": "confirmation.payment",
  "category": "evidence",
  "kind": "fulfillment_confirmation",
  "label": "预付款到账凭证（Payment Confirmation）",
  "contextRef": "context.advertising-order",
  "responsibleRoleRef": "role.advertiser",
  "attributes": [
    {
      "name": "id",
      "label": "凭证标识",
      "valueType": "id",
      "required": true,
      "meaning": "在此业务凭证类型中唯一的标识"
    },
    {
      "name": "confirmed_at",
      "timeRole": "occurrence",
      "label": "形成时刻",
      "valueType": "timestamp",
      "required": true,
      "meaning": "形成时刻",
      "keyData": true
    },
    {
      "name": "paid_amount_minor",
      "label": "核对后到账金额",
      "valueType": "int",
      "required": true,
      "meaning": "核对后到账金额，单位为 CNY 分",
      "derivedByRuleRef": "rule.payment-amount"
    },
    {
      "name": "gateway_reference",
      "label": "支付渠道流水号",
      "valueType": "id",
      "required": true,
      "meaning": "支付渠道流水号"
    }
  ],
  "callbackRoleRefs": [
    "role.payment-gateway"
  ],
  "examples": [
    {
      "label": "gateway-paid",
      "value": {
        "id": "payment-proof-one",
        "paid_amount_minor": 250000,
        "gateway_reference": "gateway-txn-01",
        "confirmed_at": "2026-06-01T10:00:00Z"
      },
      "test": {
        "flow": "prepayment-only",
        "actingRoleRef": "role.payment-gateway",
        "asOf": "2026-06-01T10:00:00Z",
        "basedOn": [
          "request.payment#payment-window"
        ]
      }
    },
    {
      "label": "summer-payment-proof",
      "value": {
        "id": "payment-proof-summer",
        "paid_amount_minor": 720000,
        "gateway_reference": "gateway-txn-02",
        "confirmed_at": "2026-07-01T12:00:00Z"
      },
      "test": {
        "flow": "negotiation-to-daily-report",
        "actingRoleRef": "role.payment-gateway",
        "asOf": "2026-07-01T12:00:00Z",
        "basedOn": [
          "request.payment#summer-payment-window"
        ]
      }
    }
  ]
}
