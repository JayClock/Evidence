{
  "type": "rule",
  "id": "rule.proposal.ads-promotion-proposal-deadline",
  "kind": "derivation",
  "label": "广告投放报价窗口为 48 小时",
  "description": "广告投放报价窗口为 48 小时",
  "contextRef": "context.advertising-negotiation",
  "bindings": {
    "self": {
      "ref": "proposal.ads-promotion-proposal"
    }
  },
  "expression": "self.started_at + duration(\"48h\")",
  "resultType": "timestamp",
  "target": {
    "entityRef": "proposal.ads-promotion-proposal",
    "attribute": "expired_at"
  }
}
