{
  "type": "rule",
  "id": "rule-breach-detection-overdue",
  "kind": "breach",
  "label": "到港交付逾期判定",
  "description": "交付确认时刻晚于交付请求的截止时刻，判定卖方交付逾期。",
  "contextRef": "ctx-main-procurement",
  "bindings": {
    "del_req": {
      "ref": "req-equipment-delivery",
      "cardinality": "one"
    },
    "del_conf": {
      "ref": "conf-equipment-delivery",
      "cardinality": "one"
    }
  },
  "expression": "del_conf.confirmed_at > del_req.expired_at",
  "resultType": "bool"
}
