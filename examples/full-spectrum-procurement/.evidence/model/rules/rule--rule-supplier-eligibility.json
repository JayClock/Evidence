{
  "type": "rule",
  "id": "rule-supplier-eligibility",
  "kind": "eligibility",
  "label": "竞标报价必须为正",
  "description": "只接收报价金额大于零的投标方案。",
  "contextRef": "ctx-sourcing",
  "bindings": {
    "proposal": {
      "ref": "doc-supplier-proposal",
      "cardinality": "one"
    }
  },
  "expression": "proposal.quoted_total_price.minorUnits > 0",
  "resultType": "bool"
}
