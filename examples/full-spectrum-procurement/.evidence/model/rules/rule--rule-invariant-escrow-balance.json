{
  "type": "rule",
  "id": "rule-invariant-escrow-balance",
  "kind": "invariant",
  "label": "托管账户全额资金锁定守恒不变式",
  "description": "托管账户中已划拨与仍冻结资金总和必须严格等于主采购合同总额[doc.escrow.agreement]",
  "contextRef": "ctx-escrow-settlement",
  "bindings": {
    "escrow": {
      "ref": "doc-escrow-agreement",
      "cardinality": "one"
    }
  },
  "expression": "escrow.escrow_locked_amount.minorUnits > 0",
  "resultType": "bool"
}
