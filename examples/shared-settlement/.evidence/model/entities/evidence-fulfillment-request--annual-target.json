{
  "type": "entity",
  "id": "request.annual-target",
  "category": "evidence",
  "kind": "fulfillment_request",
  "label": "年度收入考核指标（Annual Revenue Target）",
  "contextRef": "context.performance",
  "responsibleRoleRef": "role.account-owner",
  "attributes": [
    {
      "name": "id",
      "label": "凭证标识",
      "valueType": "id",
      "required": true,
      "meaning": "在此业务凭证类型中唯一的标识"
    },
    {
      "name": "started_at",
      "timeRole": "start",
      "label": "开启时刻",
      "valueType": "timestamp",
      "required": true,
      "meaning": "开启时刻",
      "keyData": true
    },
    {
      "name": "expired_at",
      "timeRole": "deadline",
      "label": "截止时刻",
      "valueType": "timestamp",
      "required": true,
      "meaning": "截止时刻",
      "keyData": true,
      "derivedByRuleRef": "rule.request.annual-target-deadline"
    },
    {
      "name": "target_amount_minor",
      "label": "年度指标金额",
      "valueType": "int",
      "required": true,
      "meaning": "年度指标金额，单位为 CNY 分"
    }
  ],
  "examples": [
    {
      "label": "open-year",
      "value": {
        "id": "target-2026",
        "target_amount_minor": 50000000,
        "started_at": "2026-01-02T09:00:00Z",
        "expired_at": "2027-01-02T09:00:00Z"
      },
      "test": {
        "flow": "credit-quarter-and-year-once",
        "actingRoleRef": "role.account-owner",
        "asOf": "2026-01-02T09:00:00Z",
        "basedOn": [
          "contract.performance-agreement#sign-fy26"
        ]
      }
    }
  ]
}
