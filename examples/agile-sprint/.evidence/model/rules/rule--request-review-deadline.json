{
  "type": "rule",
  "id": "rule.request.review-deadline",
  "kind": "derivation",
  "label": "迭代评审请求窗口为 48 小时",
  "description": "迭代评审请求窗口为 48 小时",
  "contextRef": "context.sprint",
  "bindings": {
    "self": {
      "ref": "request.review"
    }
  },
  "expression": "self.started_at + duration(\"48h\")",
  "resultType": "timestamp",
  "target": {
    "entityRef": "request.review",
    "attribute": "expired_at"
  }
}
