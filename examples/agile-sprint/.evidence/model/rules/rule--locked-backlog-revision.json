{
  "type": "rule",
  "id": "rule.locked-backlog-revision",
  "kind": "derivation",
  "label": "锁定请求中的待办版本",
  "description": "锁定请求中的待办版本",
  "contextRef": "context.sprint",
  "bindings": {
